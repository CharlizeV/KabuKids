#:import secondary_color colors.SECONDARY_COLOR
#:import accent_color colors.ACCENT_COLOR
#:import primary_color colors.PRIMARY_COLOR
#:import dark_color colors.DARK_COLOR
#:import light_color colors.LIGHT_COLOR
#:import super_light colors.SUPER_LIGHT
#:import dp kivy.metrics.dp

<ProfilePage>:
    name: "profile"
    canvas.before:
        Color:
            rgba: secondary_color
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [0, 0, 0, 0]  # [left, top, right, bottom]
        spacing: 40

        # --- Dashboard, Profile, Edit ---
        GridLayout:
            padding: [10, 10, 10, 10]  # [left, top, right, bottom]
            cols: 3
            size_hint_y: None
            height: 60  # Fixed header height

            # Left square (aligned left)
            ImageButton:
                source: "screens/icons/return.png"
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                on_press: app.root.current = "dashboard"

            # Center text
            Label:
                text: "Profile"
                font_name: "screens/fonts/Valekon.otf"
                font_size: 20
                color: primary_color
                halign: 'center'
                valign: 'middle'  
                text_size: self.size  # ← critical for alignment!

            # Right square 
            ImageButton:
                source: "screens/icons/edit.png"
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                on_press: app.root.current = "editProfile"

        # --- Add a Placeholder for Profile Content ---
        BoxLayout:
            orientation: 'vertical'
            halign: 'center'
            size_hint_y: None
            height: 180
            spacing: 10

            # Profile picture (clipped circle)
            StencilView:
                size_hint: None, None
                size: 120, 120
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                canvas.before:
                    Color:
                        rgba: 0.9, 0.9, 0.9, 1
                    Ellipse:
                        pos: self.pos
                        size: self.size

                Image:
                    id: profile_image
                    source: root.profile_image_source
                    size_hint: None, None
                    size: self.parent.size
                    pos: self.parent.pos
                    allow_stretch: True
                    keep_ratio: False

            Label:
                text: root.display_name
                font_name: "screens/fonts/Valekon.otf"
                halign: 'center'
                font_size: 30
                color: primary_color
                size_hint_y: None
                height: 40

        ScrollView:
            GridLayout:
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                padding: [40, 20, 40, 20]
                canvas.before:
                    Color:
                        rgba: primary_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(20), dp(20), dp(0), dp(0)]

                GridLayout:
                    cols: 2
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 10

                    Label:
                        text: "Username"
                        bold: True
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        font_size: 20
                        color: secondary_color
                        size_hint_y: None
                        height: 30

                    Label:
                        text: root.username_text
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size
                        font_size: 20
                        color: light_color
                        size_hint_y: None
                        height: 30

                    Label:
                        text: "Birthday"
                        bold: True
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        font_size: 20
                        color: secondary_color
                        size_hint_y: None
                        height: 30

                    Label:
                        text: root.birthday_text
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size
                        font_size: 20
                        color: light_color
                        size_hint_y: None
                        height: 30

                    Label:
                        text: "Gender"
                        bold: True
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        font_size: 20
                        color: secondary_color
                        size_hint_y: None
                        height: 30

                    Label:
                        text: root.gender_text
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size
                        font_size: 20
                        color: light_color
                        size_hint_y: None
                        height: 30

                # Likes header and dynamic container
                Label:
                    text: ""
                    size_hint_y: None
                    height: 10

                Label:
                    text: "My Likes"
                    font_name: "screens/fonts/Valekon.otf"
                    font_size: 25
                    size_hint_y: None
                    height: 40
                    color: secondary_color
                
                Label:
                    text: ""
                    size_hint_y: None
                    height: 10

                BoxLayout:
                    id: likes_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [20, 10]
                    spacing: 6
                    color: dark_color
                    canvas.before:
                        Color:
                            rgba: super_light
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(8), dp(8), dp(8), dp(8)]

                # Dislikes
                Label:
                    text: ""
                    size_hint_y: None
                    height: 10

                Label:
                    text: "My Dislikes"
                    font_size: 25
                    font_name: "screens/fonts/Valekon.otf"
                    size_hint_y: None
                    height: 40
                    color: secondary_color
                
                Label:
                    text: ""
                    size_hint_y: None
                    height: 10

                BoxLayout:
                    id: dislikes_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [20, 10]
                    spacing: 6
                    color: dark_color
                    canvas.before:
                        Color:
                            rgba: super_light
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(8), dp(8), dp(8), dp(8)]

                # Goals
                Label:
                    text: ""
                    size_hint_y: None
                    height: 10

                Label:
                    text: "My Goals"
                    font_name: "screens/fonts/Valekon.otf"
                    font_size: 25
                    size_hint_y: None
                    height: 40
                    color: secondary_color

                Label:
                    text: ""
                    size_hint_y: None
                    height: 10

                BoxLayout:
                    id: goals_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: [20, 10]
                    spacing: 6
                    color: dark_color
                    canvas.before:
                        Color:
                            rgba: super_light
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(8), dp(8), dp(8), dp(8)]

<ImageButton@ButtonBehavior+Image>:
    allow_stretch: True
    keep_ratio: True
    size_hint: None, None
    size: dp(50), dp(50)
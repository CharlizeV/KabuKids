#:import secondary_color colors.SECONDARY_COLOR
#:import accent_color colors.ACCENT_COLOR
#:import primary_color colors.PRIMARY_COLOR
#:import dark_color colors.DARK_COLOR
#:import light_color colors.LIGHT_COLOR
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<ProfilePage>:
    name: "profile"

    canvas.before:
        Color:
            rgba: secondary_color
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'horizontal'

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.25
            padding: dp(24), dp(22), dp(20), dp(22)
            spacing: dp(16)

            Widget:
                size_hint_y: 1

            Image:
                source: "screens/icons/logo.PNG"
                size_hint: None, None
                size: dp(250), dp(250)
                allow_stretch: True
                keep_ratio: True
                pos_hint: {"center_x": 0.5}

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(100)
                spacing: dp(2)

                Label:
                    text: "Hi there,"
                    font_name: "screens/fonts/Valekon.otf"
                    font_size: sp(30)
                    color: dark_color
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

                Label:
                    text: root.first_name
                    font_name: "screens/fonts/Valekon.otf"
                    font_size: sp(40)
                    color: primary_color
                    bold: True
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

            Widget:
                size_hint_y: None
                height: dp(24)

            ProfileSideNavItem:
                icon_source: "screens/icons/dashboard.png"
                label_text: "Home"
                on_press: app.root.current = "dashboard"

            ProfileSideNavItem:
                icon_source: "screens/icons/reports.png"
                label_text: "Reports"
                on_press: app.root.current = "report_dashboard"

            ProfileSideNavItem:
                icon_source: "screens/icons/profile.png"
                label_text: "Profile"
                on_press: app.root.current = "profile"

            Widget:
                size_hint_y: 1

            Widget:
                size_hint_y: None
                height: dp(2)

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.80
            padding: dp(28), dp(18), dp(28), dp(24)

            canvas.before:
                Color:
                    rgba: primary_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(22), 0, 0, dp(22)]

            AnchorLayout:
                anchor_x: 'left'
                anchor_y: 'top'
                padding: dp(10), dp(80), 0, 0

                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(16)
                    padding: 0, dp(2), 0, dp(10)
                    size_hint_y: None
                    height: self.minimum_height

                    BoxLayout:
                        size_hint_y: None
                        height: dp(200)
                        spacing: dp(18)
                        padding: 0, 0, 0, dp(20)

                        BoxLayout:
                            orientation: 'horizontal'
                            size_hint_x: 1
                            spacing: dp(20)

                            Image:
                                source: root.profile_image_source if root.profile_image_source else "screens/icons/logo.PNG"
                                size_hint: None, None
                                size: dp(200), dp(200)
                                allow_stretch: True
                                keep_ratio: True
                                canvas.before:
                                    Color:
                                        rgba: secondary_color
                                    Line:
                                        ellipse: (self.x, self.y, self.width, self.height)
                                        width: dp(2)

                            AnchorLayout:
                                size_hint_x: 1
                                anchor_x: 'left'
                                anchor_y: 'center'

                                BoxLayout:
                                    orientation: 'vertical'
                                    spacing: dp(7)
                                    size_hint_y: None
                                    height: dp(85)

                                    Label:
                                        text: root.display_name + " (" + root.gender_text[:1] + ")"
                                        font_name: "screens/fonts/Valekon.otf"
                                        font_size: sp(45)
                                        color: dark_color
                                        bold: True
                                        halign: 'left'
                                        valign: 'middle'
                                        text_size: self.width, None
                                        size_hint_y: None
                                        height: dp(40)
                                        shorten: True
                                        shorten_from: 'right'

                                    Label:
                                        text: root.birthday_text
                                        font_size: sp(34)
                                        color: dark_color
                                        halign: 'left'
                                        valign: 'middle'
                                        text_size: self.width, None
                                        size_hint_y: None
                                        height: dp(30)
                                    EditProfileButton:
                                        on_press: app.root.current = "editProfile"
                                        size: dp(30), dp(30)

                        Widget:
                            size_hint_x: 0.2

                        LogOutButton:
                            on_press: app.root.current = "login"
                            size: dp(64), dp(64)

                    GridLayout:
                        cols: 3
                        spacing: dp(14)
                        size_hint_y: None
                        height: dp(430)

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: dp(10)

                            Label:
                                text: "Likes"
                                font_name: "screens/fonts/Valekon.otf"
                                font_size: sp(35)
                                color: dark_color
                                bold: True
                                halign: 'left'
                                valign: 'middle'
                                text_size: self.size
                                size_hint_y: None
                                height: dp(36)

                            BoxLayout:
                                orientation: 'vertical'
                                padding: dp(10)
                                canvas.before:
                                    Color:
                                        rgba: secondary_color
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(12), dp(12), dp(12), dp(12)]

                                ScrollView:
                                    do_scroll_x: False
                                    BoxLayout:
                                        id: likes_container
                                        orientation: 'vertical'
                                        size_hint_y: None
                                        height: self.minimum_height
                                        spacing: dp(4)

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: dp(10)

                            Label:
                                text: "Dislikes"
                                font_name: "screens/fonts/Valekon.otf"
                                font_size: sp(35)
                                color: dark_color
                                bold: True
                                halign: 'left'
                                valign: 'middle'
                                text_size: self.size
                                size_hint_y: None
                                height: dp(36)

                            BoxLayout:
                                orientation: 'vertical'
                                padding: dp(10)
                                canvas.before:
                                    Color:
                                        rgba: secondary_color
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(12), dp(12), dp(12), dp(12)]

                                ScrollView:
                                    do_scroll_x: False
                                    BoxLayout:
                                        id: dislikes_container
                                        orientation: 'vertical'
                                        size_hint_y: None
                                        height: self.minimum_height
                                        spacing: dp(4)

                        BoxLayout:
                            orientation: 'vertical'
                            spacing: dp(10)

                            Label:
                                text: "Goals"
                                font_name: "screens/fonts/Valekon.otf"
                                font_size: sp(35)
                                color: dark_color
                                bold: True
                                halign: 'left'
                                valign: 'middle'
                                text_size: self.size
                                size_hint_y: None
                                height: dp(36)

                            BoxLayout:
                                orientation: 'vertical'
                                padding: dp(10)
                                canvas.before:
                                    Color:
                                        rgba: secondary_color
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(12), dp(12), dp(12), dp(12)]

                                ScrollView:
                                    do_scroll_x: False
                                    BoxLayout:
                                        id: goals_container
                                        orientation: 'vertical'
                                        size_hint_y: None
                                        height: self.minimum_height
                                        spacing: dp(4)

<ProfileSideNavItem@ButtonBehavior+BoxLayout>:
    icon_source: ""
    label_text: ""
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(72)
    spacing: dp(14)
    padding: dp(10), dp(8)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 0
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16), dp(16), dp(16), dp(16)]
    Image:
        source: root.icon_source
        size_hint: None, None
        size: dp(42), dp(42)
        allow_stretch: True
        keep_ratio: True
        pos_hint: {'center_y': 0.5}
    Label:
        text: root.label_text
        font_name: "screens/fonts/Valekon.otf"
        font_size: sp(28)
        color: dark_color
        bold: True
        halign: 'left'
        valign: 'middle'
        text_size: self.size

<EditProfileButton@ButtonBehavior+Image>:
    source: "screens/icons/edit.png"
    allow_stretch: True
    keep_ratio: True
    size_hint: None, None
    size: dp(58), dp(58)

<LogOutButton@ButtonBehavior+Image>:
    source: "screens/icons/logout.png"
    allow_stretch: True
    keep_ratio: True
    size_hint: None, None
    size: dp(58), dp(58)
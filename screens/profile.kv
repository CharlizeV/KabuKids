                    height: self.minimum_height  
                    padding: [20, 20, 20, 20]
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 0.5, 0.9, 0.5, 1 
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(20), dp(20), dp(20), dp(20)]

                    Label:
                        text: "• Eat faster"
                        halign: 'left'
                        valign: 'top'
                        text_size: self.size
                        color: 0, 0, 0, 1
                        font_size: 18
                        size_hint_y: None
                        height: self.texture_size[1]  # ← Sizes to text height
                    Label:
                        text: "• Eat even faster"
                        halign: 'left'
                        valign: 'top'
                        text_size: self.size
                        color: 0, 0, 0, 1
                        font_size: 18
                        size_hint_y: None
                        height: self.texture_size[1]  # ← Sizes to text height
                    Label:
                        text: "• Fly"
                        halign: 'left'
                        valign: 'top'
                        text_size: self.size
                        color: 0, 0, 0, 1
                        font_size: 18
                        size_hint_y: None
                        height: self.texture_size[1]  # ← Sizes to text height
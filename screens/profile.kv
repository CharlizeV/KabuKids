<ProfilePage>:
    name: "profile"
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1  # White background
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [0, 0, 0, 0]  # [left, top, right, bottom]
        spacing: 40

        # --- Dashboard, Profile, Edit ---
        GridLayout:
            padding: [10, 10, 10, 10]  # [left, top, right, bottom]
            cols: 3
            size_hint_y: None
            height: 60  # Fixed header height

            # Left square (aligned left)
            Button:
                size_hint_x: None
                width: 40
                background_color: 0, 0, 0, 0  # Transparent background
                on_release: app.root.current = "dashboard"  # ← Switches to dashboard screen

                canvas.before:
                    Color:
                        rgba: 0.2, 0.6, 1, 1  # Blue
                    Rectangle:
                        pos: self.pos
                        size: self.size

            # Center text
            Label:
                text: "Profile"
                font_size: 20
                color: 0, 0, 0, 1  # Black text
                halign: 'center'
                valign: 'middle'   # ← use 'middle', not 'center'
                text_size: self.size  # ← critical for alignment!

            # Right square (aligned right)
            Button:
                size_hint_x: None
                width: 40
                background_color: 0, 0, 0, 0  # Transparent background
                on_release: app.root.current = "editProfile"

                canvas.before:
                    Color:
                        rgba: 0.8, 0.3, 0.3, 1  # Red
                    Rectangle:
                        pos: self.pos
                        size: self.size

        # --- Add a Placeholder for Profile Content ---
        BoxLayout:
            orientation: 'vertical'
            halign: 'center'
            size_hint_y: None
            height: 180
            spacing: 10

            Widget:
                size_hint: None, None
                size: 120, 120
                pos_hint: {'center_x': 0.5, 'center_y': 0.5}
                canvas.before:
                    Color:
                        rgba: 0.9, 0.9, 0.9, 1
                    Ellipse:
                        pos: self.pos
                        size: self.size

            Label:
                text: "Charlize Villaflores"
                halign: 'center'
                font_size: 30
                color: 0, 0, 0, 1
                size_hint_y: None
                height: 40 
            
        ScrollView:
            GridLayout:
                cols: 1                             # ← MUST specify cols or rows
                size_hint_y: None 
                height: self.minimum_height  
                padding: [40, 20, 40, 20]            # [left, top, right, bottom]
                canvas.before:
                    Color:
                        rgba: 0.9, 0.9, 0.9, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(20), dp(20), dp(0), dp(0)]

                GridLayout:
                    cols: 2
                    size_hint_y: None
                    height: self.minimum_height   
                    spacing: 10

                    Label:
                        text: "Username"
                        bold: True
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        font_size: 20
                        color: 0, 0, 0, 1
                        size_hint_y: None
                        height: 30

                    Label:
                        text: "charlize_v"
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size
                        font_size: 20
                        color: 0, 0, 0, 1
                        size_hint_y: None
                        height: 30
                    
                    Label:
                        text: "Birthday"
                        bold: True
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        font_size: 20
                        color: 0, 0, 0, 1
                        size_hint_y: None
                        height: 30

                    Label:
                        text: "June 14, 2004"
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size
                        font_size: 20
                        color: 0, 0, 0, 1
                        size_hint_y: None
                        height: 30
                    
                    Label:
                        text: "Gender"
                        bold: True
                        halign: 'left'
                        valign: 'middle'
                        text_size: self.size
                        font_size: 20
                        color: 0, 0, 0, 1
                        size_hint_y: None
                        height: 30

                    Label:
                        text: "Female"
                        halign: 'right'
                        valign: 'middle'
                        text_size: self.size
                        font_size: 20
                        color: 0, 0, 0, 1
                        size_hint_y: None
                        height: 30

                #-- Likes of the user ---  

                Label:
                    text: " "
                    bold: True
                    text_size: self.size
                    halign: 'left'
                    font_size: 1
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30

                Label:
                    text: "My Likes"
                    bold: True
                    text_size: self.size
                    halign: 'left'
                    font_size: 25
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 40
                    padding: [0, 30, 0, 10] # [left, top, right, bottom]
                    
                GridLayout:
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height  
                    padding: [20, 20, 20, 20]
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 0.5, 0.9, 0.5, 1 
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(20), dp(20), dp(20), dp(20)]

                    Label:
                        text: "• Painting"
                        halign: 'left'
                        valign: 'top'
                        text_size: self.size
                        color: 0, 0, 0, 1
                        font_size: 18
                        size_hint_y: None
                        height: self.texture_size[1]  # ← Sizes to text height
                    Label:
                        text: "• Reading"
                        halign: 'left'
                        valign: 'top'
                        text_size: self.size
                        color: 0, 0, 0, 1
                        font_size: 18
                        size_hint_y: None
                        height: self.texture_size[1]  # ← Sizes to text height
                    Label:
                        text: "• Traveling"
                        halign: 'left'
                        valign: 'top'
                        text_size: self.size
                        color: 0, 0, 0, 1
                        font_size: 18
                        size_hint_y: None
                        height: self.texture_size[1]  # ← Sizes to text height
                
                
                
                #-- Dislikes of the user ---  

                Label:
                    text: " "
                    bold: True
                    text_size: self.size
                    halign: 'left'
                    font_size: 1
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30

                Label:
                    text: "My Dislikes"
                    bold: True
                    text_size: self.size
                    halign: 'left'
                    font_size: 25
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 40
                    padding: [0, 30, 0, 10] # [left, top, right, bottom]
                    
                GridLayout:
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height  
                    padding: [20, 20, 20, 20]
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 0.5, 0.9, 0.5, 1 
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(20), dp(20), dp(20), dp(20)]

                    Label:
                        text: "• insects"
                        halign: 'left'
                        valign: 'top'
                        text_size: self.size
                        color: 0, 0, 0, 1
                        font_size: 18
                        size_hint_y: None
                        height: self.texture_size[1]  # ← Sizes to text height
                    Label:
                        text: "• Horror"
                        halign: 'left'
                        valign: 'top'
                        text_size: self.size
                        color: 0, 0, 0, 1
                        font_size: 18
                        size_hint_y: None
                        height: self.texture_size[1]  # ← Sizes to text height
                    Label:
                        text: "• Jumpscares"
                        halign: 'left'
                        valign: 'top'
                        text_size: self.size
                        color: 0, 0, 0, 1
                        font_size: 18
                        size_hint_y: None
                        height: self.texture_size[1]  # ← Sizes to text height

                #-- Goals of the user ---  

                Label:
                    text: " "
                    bold: True
                    text_size: self.size
                    halign: 'left'
                    font_size: 1
                    color: 0, 0, 0, 1
                    size_hint_y: None
                    height: 30

                Label:
                    text: "My Goals"
                    bold: True
                    text_size: self.size
                    halign: 'left'
                    font_size: 25
                    color: 0, 0, 0, 1
                    size_hint_y: None

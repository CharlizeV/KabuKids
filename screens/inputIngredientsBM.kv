<InputIngredientsBMPage>:
    name: "inputIngredientsBM"

    canvas.before:
        Color:
            rgba: 1, 1, 1, 1  # White background
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [0, 0, 0, 0]
        spacing: 0

        # --- Header ---
        GridLayout:
            cols: 3
            size_hint_y: None
            height: 60
            padding: [10, 10, 10, 10]

            Button:
                size_hint_x: None
                width: 40
                background_color: 0, 0, 0, 0
                on_release: app.root.current = "dashboard"
                canvas.before:
                    Color:
                        rgba: 0.2, 0.6, 1, 1  # Blue arrow/back
                    Rectangle:
                        pos: self.pos
                        size: self.size

            Label:
                text: "Input Food"
                font_size: 20
                color: 0, 0, 0, 1
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            Button:
                size_hint_x: None
                width: 40
                text: "→"
                background_color: 0, 0, 0, 0
                color: 0.8, 0.3, 0.3, 1
                font_size: 20
                on_release: app.root.current = "portionSizeBefore"

        # --- Scrollable Content ---
        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                padding: [20, 20, 20, 20]
                spacing: 15
                size_hint_y: None
                height: self.minimum_height

                # Main Title
                Label:
                    text: "INPUT INGREDIENTS"
                    font_size: 24
                    bold: True
                    color: 0, 0, 0, 1
                    halign: 'left'
                    text_size: self.size
                    size_hint_y: None
                    height: 40

                # Ingredients Tag Container
                BoxLayout:
                    id: ingredients_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height if self.children else 40
                    padding: [10, 10]
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 0.95, 0.95, 0.95, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                    # Example ingredient (optional)
                    BoxLayout:
                        size_hint_y: None
                        height: 32
                        spacing: 6
                        canvas.before:
                            Color:
                                rgba: 0.85, 0.85, 0.85, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size
                        Label:
                            text: "chicken"
                            font_size: '15sp'
                            color: 0, 0, 0, 1
                            halign: 'left'
                            valign: 'center'
                            text_size: self.size
                        Button:
                            text: "×"
                            size_hint_x: None
                            width: 26
                            background_normal: ''
                            background_color: 1, 0.4, 0.4, 1
                            color: 1, 1, 1, 1
                            font_size: '17sp'
                            on_press: root.remove_ingredient(self.parent)

                    # Add Ingredient Button
                    Button:
                        size_hint_y: None
                        height: 32
                        text: "+ Add Ingredient"
                        font_size: '16sp'
                        background_normal: ''
                        background_color: 0.9, 0.9, 0.9, 1
                        color: 0, 0, 0, 1
                        halign: 'center'
                        on_press: root.add_tag_prompt("ingredients")
#:import secondary_color colors.SECONDARY_COLOR
#:import accent_color colors.ACCENT_COLOR
#:import primary_color colors.PRIMARY_COLOR
#:import dark_color colors.DARK_COLOR
#:import light_color colors.LIGHT_COLOR
#:import super_light colors.SUPER_LIGHT
#:import dp kivy.metrics.dp

<InputIngredientsBMPage>:
    name: "inputIngredientsBM"

    canvas.before:
        Color:
            rgba: primary_color
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [0, 0, 0, 0]
        spacing: 0

        # --- Header ---
        GridLayout:
            cols: 3
            size_hint_y: None
            height: 60
            padding: [10, 10, 10, 10]

            ImageButton:
                source: "screens/icons/dashboard.png"
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                on_press: app.root.current = "dashboard"

            Label:
                text: "Input Food"
                font_name: "screens/fonts/Valekon.otf"
                font_size: 35
                color: secondary_color
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            ImageButton:
                source: "screens/icons/next.png"
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                on_press: app.root.current = "session"

        # --- Scrollable Content ---
        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                padding: [20, 20, 20, 20]
                spacing: 15
                size_hint_y: None
                height: self.minimum_height

                # Main Title
                Label:
                    text: "INPUT INGREDIENTS"
                    font_name: "screens/fonts/Valekon.otf"
                    font_size: 28
                    bold: True
                    color: secondary_color
                    halign: 'left'
                    text_size: self.size
                    size_hint_y: None
                    height: 40

                # Ingredients Tag Container
                BoxLayout:
                    id: ingredients_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height if self.children else 40
                    padding: [10, 10]
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 0.95, 0.95, 0.95, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                    # Add Ingredient Button
                    Button:
                        size_hint_y: None
                        height: 32
                        text: "+ Add Ingredient"
                        font_size: '16sp'
                        background_normal: ''
                        background_color: 0.9, 0.9, 0.9, 1
                        color: 0, 0, 0, 1
                        halign: 'center'
                        on_press: root.add_tag_prompt("ingredients")

<ImageButton@ButtonBehavior+Image>:
    allow_stretch: True
    keep_ratio: True
    size_hint: None, None
    size: dp(50), dp(50)
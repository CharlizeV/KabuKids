<DashboardPage>:
    name: "dashboard"
    
    BoxLayout:
        orientation: 'vertical'
        
        # Header
        BoxLayout:
            size_hint_y: None
            height: dp(60)
            padding: dp(10)
            spacing: dp(10)
            
            # Left side: Profile picture and info
            BoxLayout:
                orientation: 'horizontal'
                spacing: dp(10)
                
                Label:
                    text: ""  
                    font_size: dp(40)
                    size_hint_x: None
                    width: dp(40)
                
                # Name and age
                BoxLayout:
                    orientation: 'vertical'
                    Label:
                        text: root.user_name
                        font_size: sp(16)
                        halign: 'left'
                        valign: 'middle'
                        size_hint_y: None
                        height: self.texture_size[1]
            
            # Right side: Edit button
            Button:
                text: "Edit"
                size_hint_x: None
                width: dp(80)
                on_press: app.root.current = "profile"

        # ====== DIVIDER LINE ======
        Widget:
            size_hint_y: None
            height: dp(2)
            canvas:
                Color:
                    rgba: 0.8, 0.8, 0.8, 1  # Light gray
                Rectangle:
                    pos: self.pos
                    size: self.width, dp(2)
        
        # Main content area
        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                padding: dp(20)
                spacing: dp(20)
                size_hint_y: None
                height: self.minimum_height
                
                # START MEAL button
                Button:
                    text: "START MEAL"
                    size_hint_y: None
                    height: dp(50)
                    size_hint_x: 0.99  # 90% of parent width
                    pos_hint: {'center_x': 0.5}
                    background_color: 0.2, 0.6, 1, 1  # Blue color
                    on_press: app.root.current = "inputIngredientsBM"
                
                # TUTORIAL section
                Label:
                    text: "TUTORIAL"
                    font_size: sp(18)
                    size_hint_y: None
                    height: self.texture_size[1]
                    halign: 'left'
                    text_size: self.size
                
                # Tutorial placeholder
                BoxLayout:
                    size_hint_y: None
                    height: dp(150)
                    canvas.before:
                        Color:
                            rgba: 0.9, 0.9, 0.9, 1  # Light gray
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(10),]
                    # Add tutorial content here later
                
                # PREVIOUS MEALS section
                Label:
                    text: "PREVIOUS MEALS"
                    font_size: sp(18)
                    size_hint_y: None
                    height: self.texture_size[1]
                    halign: 'left'
                    text_size: self.size
                
                # Container for dynamic meal items
                BoxLayout:
                    id: meals_list  # key
                    orientation: 'vertical'
                    spacing: dp(10)
                    size_hint_y: None
                    height: self.minimum_height
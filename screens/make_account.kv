#:import secondary_color colors.SECONDARY_COLOR
#:import primary_color colors.PRIMARY_COLOR
#:import dark_color colors.DARK_COLOR
#:import accent_color colors.ACCENT_COLOR

<MakeAccountPage>:
    name: "make_account"

    FloatLayout:
        canvas.before:
            Color:
                rgba: secondary_color
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: "vertical"
            size_hint: 0.9, 0.85
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            padding: 20
            spacing: 15

            canvas.before:
                Color:
                    rgba: primary_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20,]

            Label:
                text: "Create Profile for Child"
                font_size: 24
                color: dark_color
                size_hint_y: None
                height: 40
                halign: "center"
                valign: "middle"
                text_size: self.size

            ScrollView:
                BoxLayout:
                    orientation: 'vertical'
                    padding: [20, 20, 20, 20]
                    spacing: 15
                    size_hint_y: None
                    height: self.minimum_height

                    # Profile Picture — UPDATED
                    BoxLayout:
                        size_hint_y: None
                        height: 100
                        spacing: 10
                        StencilView:
                            size_hint: None, None
                            size: 80, 80
                            pos_hint: {'center_y': 0.5}
                            canvas:
                                Ellipse:
                                    pos: self.pos
                                    size: self.size
                            Image:
                                id: profile_image
                                source: ''
                                size: 80, 80
                                pos: self.pos
                                allow_stretch: True
                                keep_ratio: False
                        Button:
                            text: "Edit Photo"
                            size_hint: None, None
                            size: 120, 40
                            pos_hint: {'center_y': 0.5}
                            on_release: app.select_profile_picture()

                    # NAME
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: 60
                        spacing: 5
                        Label:
                            text: "NAME"
                            size_hint_y: None
                            height: 20
                            color: 0, 0, 0, 1
                            font_size: 14
                            halign: 'left'
                            text_size: self.width, None
                        TextInput:
                            id: name_input
                            hint_text: "Enter your name"
                            multiline: False
                            size_hint_y: None
                            height: 40
                            background_color: 0.95, 0.95, 0.95, 1
                            padding: [10, 10]

                    # BIRTHDAY
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: 60
                        spacing: 5
                        Label:
                            text: "BIRTHDAY"
                            size_hint_y: None
                            height: 20
                            color: 0, 0, 0, 1
                            font_size: 14
                            halign: 'left'
                            text_size: self.width, None
                        TextInput:
                            id: birthday_input
                            hint_text: "MM/DD/YYYY"
                            multiline: False
                            size_hint_y: None
                            height: 40
                            background_color: 0.95, 0.95, 0.95, 1
                            padding: [10, 10]

                    # GENDER
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: 60
                        spacing: 5
                        Label:
                            text: "GENDER"
                            size_hint_y: None
                            height: 20
                            color: 0, 0, 0, 1
                            font_size: 14
                            halign: 'left'
                            text_size: self.width, None
                        TextInput:
                            id: gender_input
                            hint_text: "e.g., Female, Male"
                            multiline: False
                            size_hint_y: None
                            height: 40
                            background_color: 0.95, 0.95, 0.95, 1
                            padding: [10, 10]

                    # LIKES
                    Label:
                        text: "LIKES:"
                        font_size: 20
                        bold: True
                        color: 0, 0, 0, 1
                        halign: 'left'
                        size_hint_y: None
                        height: 35
                    BoxLayout:
                        id: likes_container
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height if self.children else 40
                        padding: [10, 10]
                        spacing: 8
                        canvas.before:
                            Color:
                                rgba: 0.9, 0.9, 0.9, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size
                        Button:
                            size_hint_y: None
                            height: 30
                            text: "+"
                            font_size: '20sp'
                            background_normal: ''
                            background_color: 0.85, 0.85, 0.85, 1
                            color: 0, 0, 0, 1
                            on_press: root.add_tag_prompt("likes")

                    # DISLIKES
                    Label:
                        text: "DISLIKES:"
                        font_size: 20
                        bold: True
                        color: 0, 0, 0, 1
                        halign: 'left'
                        size_hint_y: None
                        height: 35
                    BoxLayout:
                        id: dislikes_container
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height if self.children else 40
                        padding: [10, 10]
                        spacing: 8
                        canvas.before:
                            Color:
                                rgba: 0.9, 0.9, 0.9, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size
                        Button:
                            size_hint_y: None
                            height: 30
                            text: "+"
                            font_size: '20sp'
                            background_normal: ''
                            background_color: 0.85, 0.85, 0.85, 1
                            color: 0, 0, 0, 1
                            on_press: root.add_tag_prompt("dislikes")

                    # GOALS
                    Label:
                        text: "GOALS:"
                        font_size: 20
                        bold: True
                        color: 0, 0, 0, 1
                        halign: 'left'
                        size_hint_y: None
                        height: 35
                    BoxLayout:
                        id: goals_container
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height if self.children else 40
                        padding: [10, 10]
                        spacing: 8
                        canvas.before:
                            Color:
                                rgba: 0.9, 0.9, 0.9, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size
                        Button:
                            size_hint_y: None
                            height: 30
                            text: "+"
                            font_size: '20sp'
                            background_normal: ''
                            background_color: 0.85, 0.85, 0.85, 1
                            color: 0, 0, 0, 1
                            on_press: root.add_tag_prompt("goals")

                    # Password (optional)
                    BoxLayout:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: 60
                        spacing: 5
                        Label:
                            text: "Password"
                            size_hint_y: None
                            height: 20
                            color: 0, 0, 0, 1
                            font_size: 14
                            halign: 'left'
                            text_size: self.width, None
                        TextInput:
                            multiline: False
                            size_hint_y: None
                            height: 40
                            background_color: 0.95, 0.95, 0.95, 1
                            padding: [10, 10]

                    # SAVE BUTTON
                    Button:
                        text: "Save Profile"
                        background_normal: ""
                        background_color: accent_color
                        color: primary_color
                        size_hint_y: None
                        height: 50
                        on_press: root.save_profile()
#:import PRIMARY_COLOR colors.PRIMARY_COLOR
#:import SECONDARY_COLOR colors.SECONDARY_COLOR
#:import DARK_COLOR colors.DARK_COLOR

<TranscriptPage>:
    name: "transcript"
    canvas.before:
        Color:
            rgba: PRIMARY_COLOR
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [20, 20]
        spacing: 15

        BoxLayout:
            size_hint_y: None
            height: 60
            spacing: 10

            Label:
                text: "Transcript"
                font_size: '28sp'
                bold: True
                color: DARK_COLOR
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            Button:
                size_hint_x: None
                width: 50
                background_normal: ''
                background_color: 0.7, 0.7, 0.7, 1
                text: "<"
                font_size: '24sp'
                color: DARK_COLOR
                on_press: app.root.current = "report"

        Widget:
            size_hint_y: None
            height: 2
            canvas:
                Color:
                    rgba: 0.7, 0.7, 0.7, 1
                Rectangle:
                    pos: (self.parent.x + self.parent.width * 0.005, self.y)
                    size: (self.parent.width * 0.99, 2)

        ScrollView:
            BoxLayout:
                id: transcript_content
                orientation: 'vertical'
                size_hint_y: None
                size_hint_x: 1
                height: self.minimum_height
                spacing: 15
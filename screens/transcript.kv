#:import secondary_color colors.SECONDARY_COLOR
#:import accent_color colors.ACCENT_COLOR
#:import primary_color colors.PRIMARY_COLOR
#:import dark_color colors.DARK_COLOR
#:import light_color colors.LIGHT_COLOR
#:import super_light colors.SUPER_LIGHT
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<TranscriptPage>:
    name: "transcript"
    canvas.before:
        Color:
            rgba: secondary_color
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'horizontal'

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.25
            padding: dp(24), dp(22), dp(20), dp(22)
            spacing: dp(16)

            Widget:
                size_hint_y: 1

            Image:
                source: "screens/icons/logo.PNG"
                size_hint: None, None
                size: dp(250), dp(250)
                allow_stretch: True
                keep_ratio: True
                pos_hint: {"center_x": 0.5}

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(100)
                spacing: dp(2)

                Label:
                    text: "Hi there,"
                    font_name: "screens/fonts/Valekon.otf"
                    font_size: sp(30)
                    color: dark_color
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

                Label:
                    text: root.first_name
                    font_name: "screens/fonts/Valekon.otf"
                    font_size: sp(40)
                    color: primary_color
                    bold: True
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

            Widget:
                size_hint_y: None
                height: dp(24)

            TranscriptSidebarItem:
                icon_source: "screens/icons/dashboard.png"
                label_text: "Home"
                on_press: app.root.current = "dashboard"

            TranscriptSidebarItem:
                icon_source: "screens/icons/reports.png"
                label_text: "Reports"
                on_press: app.root.current = "report_dashboard"

            TranscriptSidebarItem:
                icon_source: "screens/icons/profile.png"
                label_text: "Profile"
                on_press: app.root.current = "profile"

            Widget:
                size_hint_y: 1

            Widget:
                size_hint_y: None
                height: dp(2)

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.80
            padding: dp(28), dp(18), dp(28), dp(24)

            canvas.before:
                Color:
                    rgba: primary_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(22), 0, 0, dp(22)]

            AnchorLayout:
                anchor_x: 'left'
                anchor_y: 'top'
                padding: dp(10), dp(18), 0, 0

                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(18)
                    padding: 0, dp(2), 0, dp(10)
                    size_hint_y: 1

                    BoxLayout:
                        size_hint_y: None
                        height: dp(100)
                        spacing: dp(14)

                        ReportImageButton:
                            source: "screens/icons/reports.png"
                            size: dp(90), dp(90)
                            on_press: app.root.current = "report_dashboard"
                            valign: 'middle'

                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: dp(88)
                            spacing: dp(0)

                            Label:
                                text: root.meal_date_text
                                font_name: "screens/fonts/Valekon.otf"
                                font_size: sp(48)
                                color: dark_color
                                bold: True
                                halign: 'left'
                                valign: 'bottom'
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.size

                            Label:
                                text: root.meal_time_text
                                font_size: sp(20)
                                color: dark_color
                                halign: 'left'
                                valign: 'top'
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.size

                        Widget:
                            size_hint_x: 1

                        ReportImageButton:
                            source: "screens/icons/return.png"
                            size: dp(72), dp(72)
                            pos_hint: {'center_y': 0.7} #to increase further up change to 0.8
                            on_press: app.root.current = "report"

                    BoxLayout:
                        size_hint_y: 1
                        spacing: dp(7)
                        padding: 0, dp(10), 0, 0

                        ScrollView:
                            size_hint_y: 1
                            do_scroll_x: False
                            BoxLayout:
                                id: transcript_content
                                orientation: 'vertical'
                                size_hint_y: None
                                size_hint_x: 1
                                height: self.minimum_height
                                spacing: 15
                        
<TranscriptSidebarItem@ButtonBehavior+BoxLayout>:
    icon_source: ""
    label_text: ""
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(72)
    spacing: dp(14)
    padding: dp(10), dp(8)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 0
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16), dp(16), dp(16), dp(16)]
    Image:
        source: root.icon_source
        size_hint: None, None
        size: dp(42), dp(42)
        allow_stretch: True
        keep_ratio: True
        pos_hint: {'center_y': 0.5}
    Label:
        text: root.label_text
        font_name: "screens/fonts/Valekon.otf"
        font_size: sp(28)
        color: dark_color
        bold: True
        halign: 'left'
        valign: 'middle'
        text_size: self.size

<ReportImageButton@ButtonBehavior+Image>:
    allow_stretch: True
    keep_ratio: True
    size_hint: None, None
    size: dp(50), dp(50)
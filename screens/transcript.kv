#:import secondary_color colors.SECONDARY_COLOR
#:import accent_color colors.ACCENT_COLOR
#:import primary_color colors.PRIMARY_COLOR
#:import dark_color colors.DARK_COLOR
#:import light_color colors.LIGHT_COLOR
#:import dp kivy.metrics.dp

<TranscriptPage>:
    name: "transcript"
    canvas.before:
        Color:
            rgba: primary_color
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [20, 20]
        spacing: 15

        BoxLayout:
            size_hint_y: None
            height: 60
            spacing: 10

            Label:
                text: "Transcript"
                font_name: "screens/fonts/Valekon.otf"
                font_size: 35
                bold: True
                color: secondary_color
                halign: 'left'
                valign: 'middle'
                text_size: self.size

            ImageButton:
                source: "screens/icons/return.png"
                pos_hint: {"center_x": 0.5, "center_y": 0.5}
                on_press: app.root.current = "report"

        Widget:
            size_hint_y: None
            height: 2
            canvas:
                Color:
                    rgba: 0.7, 0.7, 0.7, 1
                Rectangle:
                    pos: (self.parent.x + self.parent.width * 0.005, self.y)
                    size: (self.parent.width * 0.99, 2)

        ScrollView:
            BoxLayout:
                id: transcript_content
                orientation: 'vertical'
                size_hint_y: None
                size_hint_x: 1
                height: self.minimum_height
                spacing: 15

<ImageButton@ButtonBehavior+Image>:
    allow_stretch: True
    keep_ratio: True
    size_hint: None, None
    size: dp(50), dp(50)
<ReportPage>:
    name: "report"
    ScrollView:
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            padding: [20, 20]
            spacing: 15

            # --- Top: REPORT + Back Button ---
            BoxLayout:
                size_hint_y: None
                height: 60
                spacing: 10

                Label:
                    text: "REPORT"
                    font_size: '28sp'
                    bold: True
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

                Button:
                    size_hint_x: None
                    width: 50
                    background_normal: ''
                    background_color: 0.2, 0.6, 1, 1
                    on_press: app.root.current = "dashboard"


            # --- Date & Time ---
            Label:
                text: root.date
                font_size: '16sp'
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            Label:
                text: root.time_range
                font_size: '16sp'
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            # --- Divider ---
            Widget:
                size_hint_y: None
                height: 2
                canvas:
                    Color:
                        rgba: 0.7, 0.7, 0.7, 1
                    Rectangle:
                        pos: (self.parent.x + self.parent.width * 0.005, self.y)
                        size: (self.parent.width * 0.99, 2)

            # --- SUMMARY Header ---
            Label:
                text: "SUMMARY"
                font_size: '22sp'
                bold: True
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            # --- SUMMARY Content ---
            Label:
                text: root.summary_text
                font_size: '16sp'
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            # --- Divider ---
            Widget:
                size_hint_y: None
                height: 2
                canvas:
                    Color:
                        rgba: 0.7, 0.7, 0.7, 1
                    Rectangle:
                        pos: (self.parent.x + self.parent.width * 0.005, self.y)
                        size: (self.parent.width * 0.99, 2)

            # --- FOOD BEFORE MEAL ---
            Label:
                text: "FOOD BEFORE MEAL"
                font_size: '22sp'
                bold: True
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            Label:
                text: root.food_before_text
                font_size: '16sp'
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            # --- FOOD NOT FINISHED ---
            Label:
                text: "FOOD NOT FINISHED"
                font_size: '22sp'
                bold: True
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            Label:
                text: root.food_not_finished_text
                font_size: '16sp'
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            # --- Portion Images ---
            Label:
                text: "PORTION IMAGES"
                font_size: '22sp'
                bold: True
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: 200
                spacing: 10

                Image:
                    source: root.portion_before_source
                    fit_mode: "contain"
                    allow_stretch: True

                Image:
                    source: root.portion_after_source
                    fit_mode: "contain"
                    allow_stretch: True

            # --- Divider ---
            Widget:
                size_hint_y: None
                height: 2
                canvas:
                    Color:
                        rgba: 0.7, 0.7, 0.7, 1
                    Rectangle:
                        pos: (self.parent.x + self.parent.width * 0.005, self.y)
                        size: (self.parent.width * 0.99, 2)

            # --- INGREDIENT SUGGESTIONS Header ---
            Label:
                text: "INGREDIENT SUGGESTIONS"
                font_size: '22sp'
                bold: True
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            BoxLayout:
                size_hint_y: None
                height: self.minimum_height
                padding: [15, 15]
                canvas.before:
                    Color:
                        rgba: 0.95, 0.95, 0.95, 1
                    Line:
                        rectangle: (self.x, self.y, self.width, self.height)
                        width: 1.5

                GridLayout:
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 12
                    Label:
                        text: root.formatted_ingredient_suggestions
                        font_size: '16sp'
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width - 30, None
                        size_hint_y: None
                        height: self.texture_size[1]

            # --- Divider ---
            Widget:
                size_hint_y: None
                height: 2
                canvas:
                    Color:
                        rgba: 0.7, 0.7, 0.7, 1
                    Rectangle:
                        pos: (self.parent.x + self.parent.width * 0.005, self.y)
                        size: (self.parent.width * 0.99, 2)

            # --- CONVERSATION SUGGESTIONS Header ---
            Label:
                text: "CONVERSATION SUGGESTIONS"
                font_size: '22sp'
                bold: True
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            BoxLayout:
                size_hint_y: None
                height: self.minimum_height
                padding: [15, 15]
                canvas.before:
                    Color:
                        rgba: 0.95, 0.95, 0.95, 1
                    Line:
                        rectangle: (self.x, self.y, self.width, self.height)
                        width: 1.5

                GridLayout:
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 12
                    Label:
                        text: root.formatted_conversation_suggestions
                        font_size: '16sp'
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width - 30, None
                        size_hint_y: None
                        height: self.texture_size[1]

            # Spacer
            Widget:
                size_hint_y: None
                height: 20

            # --- TRANSCRIPT Button ---
            Button:
                text: "TRANSCRIPT"
                size_hint_y: None
                height: 60
                font_size: '20sp'
                background_normal: ''
                background_color: 0.2, 0.6, 1, 1
                color: 1, 1, 1, 1
                on_press: app.root.current = "transcript"
                canvas.before:
                    Color:
                        rgba: 0.2, 0.6, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20,]
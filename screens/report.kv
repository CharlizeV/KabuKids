#:import secondary_color colors.SECONDARY_COLOR
#:import accent_color colors.ACCENT_COLOR
#:import primary_color colors.PRIMARY_COLOR
#:import dark_color colors.DARK_COLOR
#:import light_color colors.LIGHT_COLOR
#:import super_light colors.SUPER_LIGHT
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<ReportPage>:
    name: "report"
    canvas.before:
        Color:
            rgba: secondary_color
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'horizontal'

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.25
            padding: dp(24), dp(22), dp(20), dp(22)
            spacing: dp(16)

            Widget:
                size_hint_y: 1

            Image:
                source: "screens/icons/logo.PNG"
                size_hint: None, None
                size: dp(250), dp(250)
                allow_stretch: True
                keep_ratio: True
                pos_hint: {"center_x": 0.5}

            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: dp(100)
                spacing: dp(2)

                Label:
                    text: "Hi there,"
                    font_name: "screens/fonts/Valekon.otf"
                    font_size: sp(30)
                    color: dark_color
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

                Label:
                    text: root.first_name
                    font_name: "screens/fonts/Valekon.otf"
                    font_size: sp(40)
                    color: primary_color
                    bold: True
                    halign: 'center'
                    valign: 'middle'
                    text_size: self.size

            Widget:
                size_hint_y: None
                height: dp(24)

            ReportInfoSidebarItem:
                icon_source: "screens/icons/dashboard.png"
                label_text: "Home"
                on_press: app.root.current = "dashboard"

            ReportInfoSidebarItem:
                icon_source: "screens/icons/reports.png"
                label_text: "Reports"
                on_press: app.root.current = "report_dashboard"

            ReportInfoSidebarItem:
                icon_source: "screens/icons/profile.png"
                label_text: "Profile"
                on_press: app.root.current = "profile"

            Widget:
                size_hint_y: 1

            Widget:
                size_hint_y: None
                height: dp(2)

        BoxLayout:
            orientation: 'vertical'
            size_hint_x: 0.80
            padding: dp(28), dp(18), dp(28), dp(24)

            canvas.before:
                Color:
                    rgba: primary_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(22), 0, 0, dp(22)]

            AnchorLayout:
                anchor_x: 'left'
                anchor_y: 'top'
                padding: dp(10), dp(18), 0, 0

                BoxLayout:
                    orientation: 'vertical'
                    spacing: dp(18)
                    padding: 0, dp(2), 0, dp(10)
                    size_hint_y: None
                    height: self.minimum_height

                    BoxLayout:
                        size_hint_y: None
                        height: dp(100)
                        spacing: dp(14)

                        ReportImageButton:
                            source: "screens/icons/reports.png"
                            size: dp(90), dp(90)
                            on_press: app.root.current = "report_dashboard"
                            valign: 'middle'

                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: dp(88)
                            spacing: dp(0)

                            Label:
                                text: root.date
                                font_name: "screens/fonts/Valekon.otf"
                                font_size: sp(48)
                                color: dark_color
                                bold: True
                                halign: 'left'
                                valign: 'bottom'
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.size

                            Label:
                                text: root.time_range
                                font_size: sp(20)
                                color: dark_color
                                halign: 'left'
                                valign: 'top'
                                size_hint_y: None
                                height: self.texture_size[1]
                                text_size: self.size

                        Widget:
                            size_hint_x: 1

                        ReportImageButton:
                            source: "screens/icons/return.png"
                            size: dp(72), dp(72)
                            pos_hint: {'center_y': 0.7} #to increase further up change to 0.8
                            on_press: app.root.current = "report_dashboard"

                    BoxLayout:
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: dp(7)
                        padding: 0, dp(10), 0, 0

                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_x: 0.60
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: dp(15)
                            padding: 0, 0, 0, dp(8)

                            Label:
                                text: "SUMMARY"
                                font_name: "screens/fonts/Valekon.otf"
                                font_size: sp(25)
                                color: dark_color
                                bold: True
                                halign: 'left'
                                valign: 'middle'
                                size_hint_y: None
                                height: dp(32)
                                text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                size_hint_x: 0.95
                                height: dp(210)
                                padding: dp(14), dp(12)
                                canvas.before:
                                    Color:
                                        rgba: primary_color
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(14)]
                                    Color:
                                        rgba: dark_color
                                    Line:
                                        rounded_rectangle: (self.x, self.y, self.width, self.height, dp(14))
                                        width: 1.3

                                ScrollView:
                                    do_scroll_x: False
                                    do_scroll_y: True
                                    bar_width: dp(8)
                                    background_color: 0, 0, 0, 0

                                    Label:
                                        text: root.summary_text
                                        font_size: sp(18)
                                        color: dark_color
                                        halign: 'left'
                                        valign: 'top'
                                        text_size: self.width - dp(8), None
                                        size_hint_y: None
                                        height: self.texture_size[1]

                            Label:
                                text: "CONVERSATION SUGGESTIONS"
                                font_name: "screens/fonts/Valekon.otf"
                                font_size: sp(25)
                                color: dark_color
                                bold: True
                                halign: 'left'
                                valign: 'middle'
                                size_hint_y: None
                                height: dp(32)
                                text_size: self.size

                            BoxLayout:
                                size_hint_y: None
                                height: dp(210)
                                size_hint_x: 0.95
                                padding: dp(14), dp(12)
                                canvas.before:
                                    Color:
                                        rgba: primary_color
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(14)]
                                    Color:
                                        rgba: dark_color
                                    Line:
                                        rounded_rectangle: (self.x, self.y, self.width, self.height, dp(14))
                                        width: 1.3

                                ScrollView:
                                    do_scroll_x: False
                                    do_scroll_y: True
                                    bar_width: dp(8)
                                    background_color: 0, 0, 0, 0

                                    Label:
                                        text: root.formatted_conversation_suggestions
                                        font_size: sp(18)
                                        color: dark_color
                                        halign: 'left'
                                        valign: 'top'
                                        text_size: self.width - dp(8), None
                                        size_hint_y: None
                                        height: self.texture_size[1]

                            AnchorLayout:
                                size_hint_y: None
                                height: dp(100)
                                anchor_x: 'left'
                                anchor_y: 'center'

                                Button:
                                    text: "TRANSCRIPT"
                                    font_name: "screens/fonts/Valekon.otf"
                                    size_hint: 0.95, None
                                    height: dp(58)
                                    font_size: sp(32)
                                    background_normal: ''
                                    background_down: ''
                                    background_color: 0, 0, 0, 0
                                    color: primary_color
                                    bold: True
                                    on_press: app.root.current = "transcript"
                                    canvas.before:
                                        Color:
                                            rgba: accent_color
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [dp(16), dp(16), dp(16), dp(16)]

                        AnchorLayout:
                            anchor_x: 'center'
                            anchor_y: 'top'
                            size_hint_x: 0.40
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: dp(620)

                                canvas.before:
                                    Color:
                                        rgba: secondary_color
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [dp(16), dp(16), dp(16), dp(16)]

                                AnchorLayout:
                                    anchor_x: 'left'
                                    anchor_y: 'top'
                                    padding: dp(7), dp(7), dp(7), dp(7)

                                    BoxLayout:
                                        orientation: 'vertical'
                                        spacing: dp(12)
                                        padding: dp(12), dp(20), dp(12), dp(12)
                                        size_hint_y: None
                                        height: self.minimum_height

                                        Label:
                                            text: "Today's Menu"
                                            font_name: "screens/fonts/Valekon.otf"
                                            font_size: sp(26)
                                            color: dark_color
                                            bold: True
                                            halign: 'left'
                                            valign: 'middle'
                                            size_hint_y: None
                                            height: dp(28)
                                            text_size: self.size

                                        BoxLayout:
                                            size_hint_y: None
                                            height: dp(130)
                                            padding: dp(16), dp(12)
                                            canvas.before:
                                                Color:
                                                    rgba: primary_color
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [dp(14)]
                                            ScrollView:
                                                do_scroll_x: True
                                                do_scroll_y: True
                                                bar_width: dp(8)
                                                background_color: 0, 0, 0, 0

                                                Label:
                                                    text: root.food_before_text
                                                    font_size: sp(18)
                                                    color: dark_color
                                                    halign: 'left'
                                                    valign: 'top'
                                                    text_size: self.width - dp(12), None
                                                    size_hint_y: None
                                                    height: self.texture_size[1]

                                        BoxLayout:
                                            size_hint_y: None
                                            height: dp(40)
                                            padding: 0, dp(10), 0, 0

                                            Label:
                                                text: "Leftovers"
                                                font_name: "screens/fonts/Valekon.otf"
                                                font_size: sp(26)
                                                color: dark_color
                                                bold: True
                                                halign: 'left'
                                                valign: 'middle'
                                                size_hint_y: None
                                                height: dp(28)
                                                text_size: self.size

                                        BoxLayout:
                                            size_hint_y: None
                                            height: dp(130)
                                            padding: dp(16), dp(12)
                                            canvas.before:
                                                Color:
                                                    rgba: primary_color
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [dp(14)]

                                            ScrollView:
                                                do_scroll_x: True
                                                do_scroll_y: True
                                                bar_width: dp(8)
                                                background_color: 0, 0, 0, 0

                                                Label:
                                                    text: root.food_not_finished_text
                                                    font_size: sp(18)
                                                    color: dark_color
                                                    halign: 'left'
                                                    valign: 'top'
                                                    text_size: self.width - dp(12), None
                                                    size_hint_y: None
                                                    height: self.texture_size[1]

                                        BoxLayout:
                                            size_hint_y: None
                                            height: dp(40)
                                            padding: 0, dp(10), 0, 0
                                            Label:
                                                text: "Kabu's Picks"
                                                font_name: "screens/fonts/Valekon.otf"
                                                font_size: sp(26)
                                                color: dark_color
                                                bold: True
                                                halign: 'left'
                                                valign: 'middle'
                                                size_hint_y: None
                                                height: dp(28)
                                                text_size: self.size

                                        BoxLayout:
                                            size_hint_y: None
                                            height: dp(130)
                                            padding: dp(16), dp(12)
                                            canvas.before:
                                                Color:
                                                    rgba: primary_color
                                                RoundedRectangle:
                                                    pos: self.pos
                                                    size: self.size
                                                    radius: [dp(14)]
                                            
                                            ScrollView:
                                                do_scroll_x: True
                                                do_scroll_y: True
                                                bar_width: dp(8)
                                                background_color: 0, 0, 0, 0

                                                Label:
                                                    text: root.formatted_ingredient_suggestions
                                                    font_size: sp(18)
                                                    color: dark_color
                                                    halign: 'left'
                                                    valign: 'top'
                                                    text_size: self.width - dp(12), None
                                                    size_hint_y: None
                                                    height: self.texture_size[1]

<ReportInfoSidebarItem@ButtonBehavior+BoxLayout>:
    icon_source: ""
    label_text: ""
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(72)
    spacing: dp(14)
    padding: dp(10), dp(8)
    canvas.before:
        Color:
            rgba: 1, 1, 1, 0
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16), dp(16), dp(16), dp(16)]
    Image:
        source: root.icon_source
        size_hint: None, None
        size: dp(42), dp(42)
        allow_stretch: True
        keep_ratio: True
        pos_hint: {'center_y': 0.5}
    Label:
        text: root.label_text
        font_name: "screens/fonts/Valekon.otf"
        font_size: sp(28)
        color: dark_color
        bold: True
        halign: 'left'
        valign: 'middle'
        text_size: self.size

<ReportImageButton@ButtonBehavior+Image>:
    allow_stretch: True
    keep_ratio: True
    size_hint: None, None
    size: dp(50), dp(50)
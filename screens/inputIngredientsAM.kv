#:import secondary_color colors.SECONDARY_COLOR
#:import accent_color colors.ACCENT_COLOR
#:import primary_color colors.PRIMARY_COLOR
#:import dark_color colors.DARK_COLOR
#:import light_color colors.LIGHT_COLOR
#:import super_light colors.SUPER_LIGHT
#:import dp kivy.metrics.dp

<InputIngredientsAMPage>:
    name: "inputIngredientsAM"

    canvas.before:
        Color:
            rgba: primary_color
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [0, 0, 0, 0]
        spacing: 0

        # --- Header ---
        GridLayout:
            cols: 3
            size_hint_y: None
            height: 60
            padding: [10, 10, 10, 10]

            Label:
                text: "Input Food After Meal"
                font_name: "screens/fonts/Valekon.otf"
                font_size: 28
                color: secondary_color
                halign: 'center'
                valign: 'middle'
                text_size: self.size

        # --- Instruction Label ---
        Label:
            text: "Check the boxes of the food the child has finished."
            font_name: "screens/fonts/Valekon.otf"
            font_size: 16
            color:light_color
            halign: 'center'
            valign: 'middle'
            text_size: self.size
            size_hint_y: None
            height: 40
            padding: [20, 0]

        # --- Scrollable Checkbox List ---
        ScrollView:
            BoxLayout:
                id: food_checkboxes
                orientation: 'vertical'
                padding: [20, 10]
                spacing: 8
                size_hint_y: None
                height: self.minimum_height

        # --- FINISH BUTTON (saves the meal to DB) ---
        Button:
            text: "Finish Meal"
            font_name: "screens/fonts/Valekon.otf"
            size_hint_y: None
            height: dp(56)
            background_normal: ''
            background_color: accent_color
            color: primary_color
            on_press: root.finish_meal()
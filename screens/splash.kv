#:import secondary_color colors.SECONDARY_COLOR
#:import accent_color colors.ACCENT_COLOR
#:import primary_color colors.PRIMARY_COLOR
#:import dp kivy.metrics.dp

<SplashScreen>:
    name: "splash"

    canvas.before:
        Color:
            rgba: secondary_color
        Rectangle:
            pos: self.pos
            size: self.size

    on_touch_down: 
        if self.collide_point(*args[1].pos): app.root.current = "login"

    BoxLayout:
        orientation: "vertical"
        size_hint: 0.92, 0.80
        pos_hint: {"center_x": 0.5, "top": 0.93}
        padding: 0, dp(10), 0, 0
        spacing: dp(14)

        Label:
            text: "Kabu Kids!"
            font_name: "screens/fonts/Valekon.otf"
            font_size: min(root.width * 0.085, root.height * 0.16)
            color: primary_color
            halign: "center"
            valign: "middle"
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]

        FloatLayout:
            size_hint_y: None
            height: min(root.width * 0.34, dp(470))

            Image:
                source: "screens/icons/logo.PNG"
                size_hint: None, None
                size: min(root.width * 0.34, dp(470)), min(root.width * 0.34, dp(470))
                pos_hint: {"center_x": 0.5, "center_y": 0.58}
                allow_stretch: True
                keep_ratio: True

    AnchorLayout:
        anchor_x: "center"
        anchor_y: "bottom"
        size_hint: 1, 1
        padding: 0, 0, 0, dp(28)

        Label:
            text: "Click Anywhere to Start"
            font_size: min(root.width * 0.042, dp(50))
            halign: "center"
            valign: "middle"
            text_size: self.width, None
            color: primary_color
            size_hint: 0.95, None
            height: self.texture_size[1] + dp(10)
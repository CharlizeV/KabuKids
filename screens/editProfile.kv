<EditProfilePage>:
    name: "editProfile"
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [0, 0, 0, 0]
        spacing: 0

        # Header (fixed height)
        GridLayout:
            padding: [10, 10, 10, 10]
            cols: 3
            size_hint_y: None
            height: 60

            # Left square
            Button:
                size_hint_x: None
                width: 40
                background_color: 0, 0, 0, 0
                on_release: app.root.current = "profile"
                canvas.before:
                    Color:
                        rgba: 0.2, 0.6, 1, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

            # Center text
            Label:
                text: "Edit Profile"
                font_size: 20
                color: 0, 0, 0, 1
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            # Right square
            Button:
                size_hint_x: None
                width: 40
                background_color: 0, 0, 0, 0
                # call save then go back to profile
                on_release: app.root.current = "login"
                canvas.before:
                    Color:
                        rgba: 0.8, 0.3, 0.3, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

        # Content area - This will now expand to fill remaining space
        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                padding: [20, 20, 20, 20]
                spacing: 15
                size_hint_y: None
                height: self.minimum_height

                # --- Profile Picture as Circle ---
                BoxLayout:
                    size_hint_y: None
                    height: 100
                    spacing: 10

                    Image:
                        id: profile_image
                        size_hint_x: None
                        width: 80
                        allow_stretch: True
                        keep_ratio: True
                        source: ""   # will be set in Python on_pre_enter or when selecting an image

                    Button:
                        text: "Edit Photo"
                        size_hint_x: None
                        width: 120
                        size_hint_y: None
                        height: 40
                        pos_hint: {'center_y': 0.5}
                        on_release: app.select_profile_picture()

                # --- Name Field ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 60
                    spacing: 5
                    Label:
                        text: "NAME"
                        size_hint_y: None
                        height: 20
                        color: 0, 0, 0, 1
                        font_size: 14
                        halign: 'left'
                        text_size: self.width, None
                    TextInput:
                        id: name_input
                        hint_text: "Enter your name"
                        multiline: False
                        size_hint_y: None
                        height: 40
                        background_color: 0.95, 0.95, 0.95, 1
                        padding: [10, 10]

                # --- USERNAME Field ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 60
                    spacing: 5
                    Label:
                        text: "USERNAME"
                        size_hint_y: None
                        height: 20
                        color: 0, 0, 0, 1
                        font_size: 14
                        halign: 'left'
                        text_size: self.width, None
                    TextInput:
                        id: username_input
                        hint_text: "Enter username"
                        multiline: False
                        size_hint_y: None
                        height: 40
                        background_color: 0.95, 0.95, 0.95, 1
                        padding: [10, 10]

                # --- PASSWORD Field ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 60
                    spacing: 5
                    Label:
                        text: "PASSWORD"
                        size_hint_y: None
                        height: 20
                        color: 0, 0, 0, 1
                        font_size: 14
                        halign: 'left'
                        text_size: self.width, None
                    TextInput:
                        id: password_input
                        hint_text: "Leave blank to keep current"
                        password: True
                        multiline: False
                        size_hint_y: None
                        height: 40
                        background_color: 0.95, 0.95, 0.95, 1
                        padding: [10, 10]

                # --- Birthday Field ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 60
                    spacing: 5
                    Label:
                        text: "BIRTHDAY"
                        size_hint_y: None
                        height: 20
                        color: 0, 0, 0, 1
                        font_size: 14
                        halign: 'left'
                        text_size: self.width, None
                    TextInput:
                        id: birthday_input
                        hint_text: "MM/DD/YYYY"
                        multiline: False
                        size_hint_y: None
                        height: 40
                        background_color: 0.95, 0.95, 0.95, 1
                        padding: [10, 10]

                # --- Gender Field ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 60
                    spacing: 5
                    Label:
                        text: "GENDER"
                        size_hint_y: None
                        height: 20
                        color: 0, 0, 0, 1
                        font_size: 14
                        halign: 'left'
                        text_size: self.width, None
                    TextInput:
                        id: gender_input
                        hint_text: "e.g., Female, Male"
                        multiline: False
                        size_hint_y: None
                        height: 40
                        background_color: 0.95, 0.95, 0.95, 1
                        padding: [10, 10]

                # --- LIKES ---
                Label:
                    text: "LIKES:"
                    font_size: 20
                    bold: True
                    color: 0, 0, 0, 1
                    halign: 'left'
                    size_hint_y: None
                    height: 35

                BoxLayout:
                    id: likes_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height if self.children else 40
                    padding: [10, 10]
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 0.9, 0.9, 0.9, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                    # (no sample tags here — tags are added programmatically on enter)

                # --- DISLIKES ---
                Label:
                    text: "DISLIKES:"
                    font_size: 20
                    bold: True
                    color: 0, 0, 0, 1
                    halign: 'left'
                    size_hint_y: None
                    height: 35

                BoxLayout:
                    id: dislikes_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height if self.children else 40
                    padding: [10, 10]
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 0.9, 0.9, 0.9, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                # --- Goals ---
                Label:
                    text: "GOALS:"
                    font_size: 20
                    bold: True
                    color: 0, 0, 0, 1
                    halign: 'left'
                    size_hint_y: None
                    height: 35

                BoxLayout:
                    id: goals_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height if self.children else 40
                    padding: [10, 10]
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 0.9, 0.9, 0.9, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                    # Add Tag Button for goals
                    Button:
                        size_hint_y: None
                        height: 30
                        text: "+"
                        font_size: '20sp'
                        background_normal: ''
                        background_color: 0.85, 0.85, 0.85, 1
                        color: 0, 0, 0, 1
                        on_press: root.add_tag_prompt("goals")


                # --- Save Button ---
                Button:
                    text: "Save Profile"
                    size_hint_y: None
                    height: 50
                    background_color: 0.2, 0.6, 1, 1
                    color: 1, 1, 1, 1
                    font_size: 18
                    on_release: root.save_profile(); app.root.current = "profile"

                # --- Debugging Info ---
                Label:
                    text: ""   # removed debug expression to avoid Builder error
                    size_hint_y: None
                    height: 20
                    color: 1, 0, 0, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                    opacity: 0.8

                # --- Footer Space ---
                Widget:
                    size_hint_y: None
                    height: 50  # Fixed height for footer space
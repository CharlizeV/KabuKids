#:import secondary_color colors.SECONDARY_COLOR
#:import primary_color colors.PRIMARY_COLOR
#:import dark_color colors.DARK_COLOR
#:import accent_color colors.ACCENT_COLOR
#:import dp kivy.metrics.dp

<EditProfilePage>:
    name: "editProfile"

    FloatLayout:
        canvas.before:
            Color:
                rgba: secondary_color
            Rectangle:
                pos: self.pos
                size: self.size

        BoxLayout:
            orientation: "horizontal"
            size_hint: 1, 1
            padding: dp(28), dp(24)
            spacing: dp(26)

            BoxLayout:
                orientation: "vertical"
                size_hint_x: 0.68
                padding: dp(34)
                spacing: dp(12)

                canvas.before:
                    Color:
                        rgba: primary_color
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [dp(22),]

                Label:
                    text: "Edit Profile"
                    font_name: "screens/fonts/Valekon.otf"
                    font_size: dp(70)
                    color: dark_color
                    size_hint_y: None
                    height: dp(150)
                    halign: "left"
                    valign: "top"
                    text_size: self.size

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(130)
                    spacing: dp(22)

                    BoxLayout:
                        orientation: "vertical"
                        size_hint_x: None
                        width: dp(170)
                        spacing: dp(10)

                        StencilView:
                            size_hint: None, None
                            size: dp(150), dp(150)

                            canvas.before:
                                Color:
                                    rgba: 0.93, 0.84, 0.41, 1
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                            Image:
                                id: profile_image
                                source: ""
                                size_hint: None, None
                                size: self.parent.size
                                pos: self.parent.pos
                                allow_stretch: True
                                keep_ratio: False

                        Button:
                            text: "Edit Photo"
                            font_name: "screens/fonts/Valekon.otf"
                            font_size: dp(20)
                            size_hint_y: None
                            height: dp(36)
                            background_normal: ""
                            background_color: secondary_color
                            color: dark_color
                            on_release: app.select_profile_picture()

                    BoxLayout:
                        orientation: "vertical"
                        spacing: dp(8)

                        Label:
                            text: "Username"
                            color: 0.12, 0.25, 0.18, 1
                            font_size: dp(28)
                            size_hint_y: None
                            height: dp(34)
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                        RoundedField:
                            id: username_input
                            hint_text: ""

                Label:
                    text: "Name"
                    color: 0.12, 0.25, 0.18, 1
                    font_size: dp(32)
                    size_hint_y: None
                    height: dp(34)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                RoundedField:
                    id: name_input
                    hint_text: ""

                Label:
                    text: "Password"
                    color: 0.12, 0.25, 0.18, 1
                    font_size: dp(32)
                    size_hint_y: None
                    height: dp(34)
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                RoundedField:
                    id: password_input
                    password: True
                    hint_text: ""

                BoxLayout:
                    size_hint_y: None
                    height: dp(92)
                    spacing: dp(18)

                    BoxLayout:
                        orientation: "vertical"
                        spacing: dp(6)

                        Label:
                            text: "Birthday"
                            color: 0.12, 0.25, 0.18, 1
                            font_size: dp(32)
                            size_hint_y: None
                            height: dp(34)
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                        Button:
                            id: birthday_button
                            text: root.birthday_display_text
                            font_name: "screens/fonts/Valekon.otf"
                            font_size: dp(18)
                            background_normal: ""
                            background_color: 0.93, 0.93, 0.93, 1
                            color: dark_color
                            size_hint_y: None
                            height: dp(56)
                            on_release: root.open_birthday_picker()
                            canvas.before:
                                Color:
                                    rgba: 0.93, 0.93, 0.93, 1
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(18),]

                    BoxLayout:
                        orientation: "vertical"
                        spacing: dp(6)

                        Label:
                            text: "Gender"
                            color: 0.12, 0.25, 0.18, 1
                            font_size: dp(32)
                            size_hint_y: None
                            height: dp(34)
                            halign: "left"
                            valign: "middle"
                            text_size: self.size

                        RoundedField:
                            id: gender_input
                            hint_text: ""

                TextInput:
                    id: birthday_input
                    opacity: 0
                    disabled: True
                    size_hint_y: None
                    height: 0

                BoxLayout:
                    size_hint_y: None
                    height: dp(64)
                    spacing: dp(18)
                    padding: [0, dp(10), 0, 0]

                    Button:
                        text: "SAVE PROFILE"
                        font_name: "screens/fonts/Valekon.otf"
                        font_size: dp(35)
                        background_normal: ""
                        background_color: secondary_color
                        color: dark_color
                        on_release: root.save_profile(); app.root.current = "profile"

                    Button:
                        text: "CANCEL"
                        font_name: "screens/fonts/Valekon.otf"
                        font_size: dp(35)
                        background_normal: ""
                        background_color: accent_color
                        color: primary_color
                        on_release: app.root.current = "profile"

            BoxLayout:
                orientation: "vertical"
                size_hint_x: 0.32
                spacing: dp(2)
                padding: [0, dp(4), 0, dp(4)]

                TagSection:
                    BoxLayout:
                        size_hint_y: None
                        height: dp(58)
                        spacing: dp(8)

                        Label:
                            text: "Likes"
                            font_name: "screens/fonts/Valekon.otf"
                            font_size: dp(46)
                            color: primary_color
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                            size_hint_y: None
                            height: dp(58)

                        Button:
                            text: "+"
                            size_hint: None, None
                            size: dp(48), dp(48)
                            background_normal: ""
                            background_color: primary_color
                            color: secondary_color
                            font_size: dp(44)
                            on_press: root.add_tag_prompt("likes")
                            canvas.before:
                                Color:
                                    rgba: primary_color
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                    BoxLayout:
                        size_hint_y: None
                        height: dp(180)
                        padding: dp(4)

                        canvas.before:
                            Color:
                                rgba: primary_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(16),]

                        ScrollView:
                            do_scroll_x: True
                            do_scroll_y: True
                            bar_width: dp(8)
                            background_color: 0, 0, 0, 0

                            StackLayout:
                                id: likes_container
                                orientation: "lr-tb"
                                spacing: dp(8)
                                padding: [dp(10), dp(10)]
                                size_hint_y: None
                                size_hint_x: 1
                                height: self.minimum_height

                TagSection:
                    BoxLayout:
                        size_hint_y: None
                        height: dp(58)
                        spacing: dp(8)

                        Label:
                            text: "Dislikes"
                            font_name: "screens/fonts/Valekon.otf"
                            font_size: dp(46)
                            color: primary_color
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                            size_hint_y: None
                            height: dp(58)

                        Button:
                            text: "+"
                            size_hint: None, None
                            size: dp(48), dp(48)
                            background_normal: ""
                            background_color: primary_color
                            color: secondary_color
                            font_size: dp(44)
                            on_press: root.add_tag_prompt("dislikes")
                            canvas.before:
                                Color:
                                    rgba: primary_color
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                    BoxLayout:
                        size_hint_y: None
                        height: dp(180)
                        padding: dp(4)

                        canvas.before:
                            Color:
                                rgba: primary_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(16),]

                        ScrollView:
                            do_scroll_x: True
                            do_scroll_y: True
                            bar_width: dp(8)
                            background_color: 0, 0, 0, 0

                            StackLayout:
                                id: dislikes_container
                                orientation: "lr-tb"
                                spacing: dp(8)
                                padding: [dp(10), dp(10)]
                                size_hint_y: None
                                size_hint_x: 1
                                height: self.minimum_height

                TagSection:
                    BoxLayout:
                        size_hint_y: None
                        height: dp(58)
                        spacing: dp(8)

                        Label:
                            text: "Goals"
                            font_name: "screens/fonts/Valekon.otf"
                            font_size: dp(46)
                            color: primary_color
                            halign: "left"
                            valign: "middle"
                            text_size: self.size
                            size_hint_y: None
                            height: dp(58)

                        Button:
                            text: "+"
                            size_hint: None, None
                            size: dp(48), dp(48)
                            background_normal: ""
                            background_color: primary_color
                            color: secondary_color
                            font_size: dp(44)
                            on_press: root.add_tag_prompt("goals")
                            canvas.before:
                                Color:
                                    rgba: primary_color
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                    BoxLayout:
                        size_hint_y: None
                        height: dp(180)
                        padding: dp(4)

                        canvas.before:
                            Color:
                                rgba: primary_color
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [dp(16),]

                        ScrollView:
                            do_scroll_x: True
                            do_scroll_y: True
                            bar_width: dp(8)
                            background_color: 0, 0, 0, 0

                            StackLayout:
                                id: goals_container
                                orientation: "lr-tb"
                                spacing: dp(8)
                                padding: [dp(10), dp(10)]
                                size_hint_y: None
                                size_hint_x: 1
                                height: self.minimum_height
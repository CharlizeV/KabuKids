<EditProfilePage>:
    name: "editProfile"
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [0, 0, 0, 0]
        spacing: 0

        # Header (fixed height)
        GridLayout:
            padding: [10, 10, 10, 10]
            cols: 3
            size_hint_y: None
            height: 60

            # Left square
            Button:
                size_hint_x: None
                width: 40
                background_color: 0, 0, 0, 0
                on_release: app.root.current = "profile"
                canvas.before:
                    Color:
                        rgba: 0.2, 0.6, 1, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

            # Center text
            Label:
                text: "Edit Profile"
                font_size: 20
                color: 0, 0, 0, 1
                halign: 'center'
                valign: 'middle'
                text_size: self.size

            # Right square
            Button:
                size_hint_x: None
                width: 40
                background_color: 0, 0, 0, 0
                on_release: app.root.current = "profile"
                canvas.before:
                    Color:
                        rgba: 0.8, 0.3, 0.3, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

        # Content area - This will now expand to fill remaining space
        ScrollView:
            BoxLayout:
                orientation: 'vertical'
                padding: [20, 20, 20, 20]
                spacing: 15
                size_hint_y: None
                height: self.minimum_height

                # --- Profile Picture as Circle ---
                BoxLayout:
                    size_hint_y: None
                    height: 100
                    spacing: 10

                    Widget:
                        size_hint_x: None
                        width: 80
                        canvas:
                            Color:
                                rgba: 0.2, 0.6, 1, 1
                            Ellipse:
                                pos: self.center_x - 40, self.center_y - 40
                                size: 80, 80

                    Button:
                        text: "Edit Photo"
                        size_hint_x: None
                        width: 120
                        size_hint_y: None
                        height: 40
                        pos_hint: {'center_y': 0.5}
                        on_release: app.select_profile_picture()

                # --- Name Field ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 60
                    spacing: 5
                    Label:
                        text: "NAME"
                        size_hint_y: None
                        height: 20
                        color: 0, 0, 0, 1
                        font_size: 14
                        halign: 'left'
                        text_size: self.width, None
                    TextInput:
                        hint_text: "Enter your name"
                        multiline: False
                        size_hint_y: None
                        height: 40
                        background_color: 0.95, 0.95, 0.95, 1
                        padding: [10, 10]

                # --- Birthday Field ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 60
                    spacing: 5
                    Label:
                        text: "BIRTHDAY"
                        size_hint_y: None
                        height: 20
                        color: 0, 0, 0, 1
                        font_size: 14
                        halign: 'left'
                        text_size: self.width, None
                    TextInput:
                        hint_text: "MM/DD/YYYY"
                        multiline: False
                        size_hint_y: None
                        height: 40
                        background_color: 0.95, 0.95, 0.95, 1
                        padding: [10, 10]

                # --- Gender Field ---
                BoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: 60
                    spacing: 5
                    Label:
                        text: "GENDER"
                        size_hint_y: None
                        height: 20
                        color: 0, 0, 0, 1
                        font_size: 14
                        halign: 'left'
                        text_size: self.width, None
                    TextInput:
                        hint_text: "e.g., Female, Male"
                        multiline: False
                        size_hint_y: None
                        height: 40
                        background_color: 0.95, 0.95, 0.95, 1
                        padding: [10, 10]

                # --- LIKES ---
                Label:
                    text: "LIKES:"
                    font_size: 20
                    bold: True
                    color: 0, 0, 0, 1
                    halign: 'left'
                    size_hint_y: None
                    height: 35

                BoxLayout:
                    id: likes_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height if self.children else 40
                    padding: [10, 10]
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 0.9, 0.9, 0.9, 1  # Light gray background
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    
                    # Add Tag Button (+)
                    Button:
                        size_hint_y: None
                        height: 30
                        text: "+"
                        font_size: '20sp'
                        background_normal: ''
                        background_color: 0.85, 0.85, 0.85, 1
                        color: 0, 0, 0, 1
                        on_press: root.add_tag_prompt("likes")

                    # Tags will be added here dynamically
                    # Pre-filled example tags:
                    BoxLayout:
                        size_hint_y: None
                        height: 30
                        spacing: 5
                        canvas.before:
                            Color:
                                rgba: 0.8, 0.8, 0.8, 1  # Gray tag box
                            Rectangle:
                                pos: self.pos
                                size: self.size
                        Label:
                            text: "anime"
                            font_size: '14sp'
                            color: 0, 0, 0, 1
                            halign: 'left'
                            valign: 'center'
                            text_size: self.size
                        Button:
                            text: "×"
                            size_hint_x: None
                            width: 25
                            background_normal: ''
                            background_color: 1, 0.4, 0.4, 1
                            color: 1, 1, 1, 1
                            font_size: '16sp'
                            on_press: root.remove_tag(self.parent)

                    BoxLayout:
                        size_hint_y: None
                        height: 30
                        spacing: 5
                        canvas.before:
                            Color:
                                rgba: 0.8, 0.8, 0.8, 1
                            Rectangle:
                                pos: self.pos
                                size: self.size
                        Label:
                            text: "games"
                            font_size: '14sp'
                            color: 0, 0, 0, 1
                            halign: 'left'
                            valign: 'center'
                            text_size: self.size
                        Button:
                            text: "×"
                            size_hint_x: None
                            width: 25
                            background_normal: ''
                            background_color: 1, 0.4, 0.4, 1
                            color: 1, 1, 1, 1
                            font_size: '16sp'
                            on_press: root.remove_tag(self.parent)

                # --- DISLIKES --- (You can add this section too)
                Label:
                    text: "DISLIKES:"
                    font_size: 20
                    bold: True
                    color: 0, 0, 0, 1
                    halign: 'left'
                    size_hint_y: None
                    height: 35

                BoxLayout:
                    id: dislikes_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height if self.children else 40
                    padding: [10, 10]
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 0.9, 0.9, 0.9, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                    # Add Tag Button for dislikes
                    Button:
                        size_hint_y: None
                        height: 30
                        text: "+"
                        font_size: '20sp'
                        background_normal: ''
                        background_color: 0.85, 0.85, 0.85, 1
                        color: 0, 0, 0, 1
                        on_press: root.add_tag_prompt("dislikes")

                # --- Goals ---
                Label:
                    text: "GOALS:"
                    font_size: 20
                    bold: True
                    color: 0, 0, 0, 1
                    halign: 'left'
                    size_hint_y: None
                    height: 35

                BoxLayout:
                    id: goals_container
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height if self.children else 40
                    padding: [10, 10]
                    spacing: 8
                    canvas.before:
                        Color:
                            rgba: 0.9, 0.9, 0.9, 1
                        Rectangle:
                            pos: self.pos
                            size: self.size

                    # Add Tag Button for goals
                    Button:
                        size_hint_y: None
                        height: 30
                        text: "+"
                        font_size: '20sp'
                        background_normal: ''
                        background_color: 0.85, 0.85, 0.85, 1
                        color: 0, 0, 0, 1
                        on_press: root.add_tag_prompt("goals")
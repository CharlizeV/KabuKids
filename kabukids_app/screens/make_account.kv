
#:import secondary_color colors.SECONDARY_COLOR
#:import primary_color colors.PRIMARY_COLOR
#:import dark_color colors.DARK_COLOR
#:import accent_color colors.ACCENT_COLOR

<MakeAccountPage>:
    name: "make_account"

    FloatLayout:
        # Full-screen background (green/yellow)
        canvas.before:
            Color:
                rgba: secondary_color
            Rectangle:
                pos: self.pos
                size: self.size

        # Fixed-size card (centered, scrollable inside)
        BoxLayout:
            orientation: "vertical"
            size_hint: 0.9, 0.85  # Slightly smaller than screen
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            padding: 20
            spacing: 15

            canvas.before:
                Color:
                    rgba: primary_color
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20,]

            # Header (fixed, not scrolled)
            Label:
                text: "Create Profile for Child"
                font_size: 24
                color: dark_color
                size_hint_y: None
                height: 40
                halign: "center"
                valign: "middle"
                text_size: self.size

            # Scrollable form area
            ScrollView:
                do_scroll_x: False
                do_scroll_y: True

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height  # Critical for scrolling!
                    padding: [0, 0, 0, 20]  # Bottom padding for last button
                    spacing: 15

                    # Name
                    Label:
                        text: "Name"
                        color: dark_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        size_hint_y: None
                        height: 30

                    TextInput:
                        id: name_input
                        multiline: False
                        background_color: 1, 1, 1, 1
                        foreground_color: dark_color
                        size_hint_y: None
                        height: 45
                        padding: [10, 10]

                    # Birthday
                    Label:
                        text: "Birthday"
                        color: dark_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        size_hint_y: None
                        height: 30

                    TextInput:
                        id: birthday_input
                        hint_text: "YYYY-MM-DD"
                        multiline: False
                        background_color: 1, 1, 1, 1
                        foreground_color: dark_color
                        size_hint_y: None
                        height: 45
                        padding: [10, 10]

                    # Likes
                    Label:
                        text: "Likes"
                        color: dark_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        size_hint_y: None
                        height: 30

                    TextInput:
                        id: likes_input
                        multiline: True
                        background_color: 1, 1, 1, 1
                        foreground_color: dark_color
                        size_hint_y: None
                        height: 100
                        padding: [10, 10]

                    # Dislikes
                    Label:
                        text: "Dislikes"
                        color: dark_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        size_hint_y: None
                        height: 30

                    TextInput:
                        id: dislikes_input
                        multiline: True
                        background_color: 1, 1, 1, 1
                        foreground_color: dark_color
                        size_hint_y: None
                        height: 100
                        padding: [10, 10]

                    # Password
                    Label:
                        text: "Password"
                        color: dark_color
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        size_hint_y: None
                        height: 30

                    TextInput:
                        id: password_input
                        multiline: False
                        password: True
                        background_color: 1, 1, 1, 1
                        foreground_color: dark_color
                        size_hint_y: None
                        height: 45
                        padding: [10, 10]

                    # Save Button
                    Button:
                        text: "Save Profile"
                        background_normal: ""
                        background_color: accent_color
                        color: primary_color
                        size_hint_y: None
                        height: 50
                        on_press: app.root.current = "login"
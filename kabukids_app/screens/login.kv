#:import secondary_color colors.SECONDARY_COLOR
#:import accent_color colors.ACCENT_COLOR
#:import primary_color colors.PRIMARY_COLOR
#:import dark_color colors.DARK_COLOR

<LoginPage>:
    name: "login"

    FloatLayout:
        # Background: full-screen secondary color
        canvas.before:
            Color:
                rgba: secondary_color
            Rectangle:
                pos: self.pos
                size: self.size

        # Login box (centered)
        BoxLayout:
            orientation: "vertical"
            size_hint: 0.8, 0.6
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            padding: 30
            spacing: 15

            canvas.before:
                Color:
                    rgba: primary_color  # background of login box
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [20,]  # optional: rounded corners

            # Header with accent dot
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: 40
                spacing: 10
                padding: [0, 0, 0, 10]

                Widget:
                    size_hint_x: None
                    width: 10
                    canvas:
                        Color:
                            rgba: accent_color
                        Ellipse:
                            pos: self.center_x - 5, self.center_y - 5
                            size: 10, 10

                Label:
                    text: "User Login"
                    font_size: 24
                    color: dark_color
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

            # Name field
            Label:
                text: "Name"
                color: dark_color
                halign: "left"
                valign: "middle"
                text_size: self.size
                size_hint_y: None
                height: 30

            TextInput:
                id: username_input
                multiline: False
                background_color: 1, 1, 1, 1  # white background
                foreground_color: dark_color
                size_hint_y: None
                height: 45
                padding: [10, 10]

            # Password field
            Label:
                text: "Password"
                color: dark_color
                halign: "left"
                valign: "middle"
                text_size: self.size
                size_hint_y: None
                height: 30

            TextInput:
                id: password_input
                multiline: False
                password: True
                background_color: 1, 1, 1, 1
                foreground_color: dark_color
                size_hint_y: None
                height: 45
                padding: [10, 10]

            # Login button
            Button:
                text: "Login"
                background_normal: ""
                background_color: accent_color
                color: primary_color  # text color
                size_hint_y: None
                height: 50
                on_press: root.do_login()

            # Create account button
            Button:
                text: "Create an Account"
                background_normal: ""
                background_color: primary_color
                color: dark_color
                size_hint_y: None
                height: 50
                canvas.before:
                    Color:
                        rgba: secondary_color  # border color via outline
                    Line:
                        width: 2
                        rectangle: (self.x, self.y, self.width, self.height)
                on_press: app.root.current = "make_account"
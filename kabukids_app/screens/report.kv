<ReportPage>:
    name: "report"
    ScrollView:
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height  # Critical for ScrollView to work
            padding: [20, 20]
            spacing: 15

            # --- Top: REPORT + Back Button ---
            BoxLayout:
                size_hint_y: None
                height: 60
                spacing: 10

                Label:
                    text: "REPORT"
                    font_size: '28sp'
                    bold: True
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

                Button:
                    size_hint_x: None
                    width: 50
                    background_normal: ''
                    background_color: 0.2, 0.6, 1, 1
                    on_press: app.root.current = "dashboard"

            # --- Date & Time ---
            Label:
                text: "October 22, 2025"
                font_size: '16sp'
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            Label:
                text: "Start Time - End Time"
                font_size: '16sp'
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            # --- Divider (99% width) ---
            Widget:
                size_hint_y: None
                height: 2
                canvas:
                    Color:
                        rgba: 0.7, 0.7, 0.7, 1
                    Rectangle:
                        pos: (self.parent.x + self.parent.width * 0.005, self.y)
                        size: (self.parent.width * 0.99, 2)

            # --- SUMMARY Header ---
            Label:
                text: "SUMMARY"
                font_size: '22sp'
                bold: True
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            # --- SUMMARY Content (wraps to full width) ---
            Label:
                text: "During the meal, the child showed interest in vegetables but refused protein sources. They engaged positively with caregivers and used utensils independently for most of the meal. This behavior suggests developing autonomy and selective food preferences, which are common at this developmental stage."
                font_size: '16sp'
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            # --- Divider ---
            Widget:
                size_hint_y: None
                height: 2
                canvas:
                    Color:
                        rgba: 0.7, 0.7, 0.7, 1
                    Rectangle:
                        pos: (self.parent.x + self.parent.width * 0.005, self.y)
                        size: (self.parent.width * 0.99, 2)

            # --- FOOD SUGGESTIONS Header ---
            Label:
                text: "FOOD SUGGESTIONS"
                font_size: '22sp'
                bold: True
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            # --- Food Suggestions Box ---
            BoxLayout:
                size_hint_y: None
                height: self.minimum_height
                padding: [15, 15]
                canvas.before:
                    Color:
                        rgba: 0.95, 0.95, 0.95, 1
                    Line:
                        rectangle: (self.x, self.y, self.width, self.height)
                        width: 1.5

                GridLayout:
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 12

                    Label:
                        text: "• Broccoli\\n    - Healthy for the child; rich in fiber, vitamins A, C, and K. It supports immune function and digestion."
                        font_size: '16sp'
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width - 30, None
                        size_hint_y: None
                        height: self.texture_size[1]

                    Label:
                        text: "• Sweet Potato\\n    - Naturally sweet and soft when cooked, making it appealing to young children. High in beta-carotene for eye health."
                        font_size: '16sp'
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width - 30, None
                        size_hint_y: None
                        height: self.texture_size[1]

            # --- Divider ---
            Widget:
                size_hint_y: None
                height: 2
                canvas:
                    Color:
                        rgba: 0.7, 0.7, 0.7, 1
                    Rectangle:
                        pos: (self.parent.x + self.parent.width * 0.005, self.y)
                        size: (self.parent.width * 0.99, 2)

            # --- CONVERSATION SUGGESTIONS Header ---
            Label:
                text: "CONVERSATION SUGGESTIONS"
                font_size: '22sp'
                bold: True
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]

            # --- Conversation Suggestions Box ---
            BoxLayout:
                size_hint_y: None
                height: self.minimum_height
                padding: [15, 15]
                canvas.before:
                    Color:
                        rgba: 0.95, 0.95, 0.95, 1
                    Line:
                        rectangle: (self.x, self.y, self.width, self.height)
                        width: 1.5

                GridLayout:
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: 12

                    Label:
                        text: "• 'What was your favorite part of lunch today?'"
                        font_size: '16sp'
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width - 30, None
                        size_hint_y: None
                        height: self.texture_size[1]

                    Label:
                        text: "• 'Can you tell me one new food you tried or would like to try next time?'"
                        font_size: '16sp'
                        halign: 'left'
                        valign: 'top'
                        text_size: self.width - 30, None
                        size_hint_y: None
                        height: self.texture_size[1]

            # Spacer to add bottom margin before transcript button
            Widget:
                size_hint_y: None
                height: 20

            # --- TRANSCRIPT Button (Rounded, full-width appearance) ---
            Button:
                text: "TRANSCRIPT"
                size_hint_y: None
                height: 60
                font_size: '20sp'
                background_normal: ''
                background_color: 0.2, 0.6, 1, 1
                color: 1, 1, 1, 1
                on_press: app.root.current = "transcript"
                canvas.before:
                    Color:
                        rgba: 0.2, 0.6, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [20,]
<ProfilePage>:
    name: "profile"
    canvas.before:
        Color:
            rgba: 1, 1, 1, 1  # White background
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [20, 20]
        spacing: 15

        # --- Top Bar: Profile Pic + Name/Birthday + Back Button ---
        BoxLayout:
            size_hint_y: None
            height: 70
            spacing: 15

            # Profile Picture Placeholder (gray square)
            Widget:
                size_hint_x: None
                width: 60
                canvas:
                    Color:
                        rgba: 0.8, 0.8, 0.8, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size

            # Name and Birthday
            BoxLayout:
                orientation: 'vertical'
                Label:
                    text: "Alex Rivera"
                    font_size: '18sp'
                    bold: True
                    color: 0, 0, 0, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                Label:
                    text: "Birthday: March 12, 2015"
                    font_size: '14sp'
                    color: 0, 0, 0, 1
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

            # Spacer
            Widget:

            # Back Button
            Button:
                size_hint_x: None
                width: 50
                background_normal: ''
                background_color: 0.7, 0.7, 0.7, 1
                text: "<"
                font_size: '24sp'
                color: 0, 0, 0, 1
                on_press: app.root.current = "dashboard"

        # --- Divider (80% width) ---
        Widget:
            size_hint_y: None
            height: 2
            canvas:
                Color:
                    rgba: 0.7, 0.7, 0.7, 1
                Rectangle:
                    pos: (self.parent.x + self.parent.width * 0.1, self.y)
                    size: (self.parent.width * 0.8, 2)

        # --- LIKES ---
        Label:
            text: "LIKES:"
            font_size: '20sp'
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            size_hint_y: None
            height: 35

        BoxLayout:
            id: likes_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height if self.children else 40
            padding: [10, 10]
            spacing: 8
            canvas.before:
                Color:
                    rgba: 0.9, 0.9, 0.9, 1  # Light gray background
                Rectangle:
                    pos: self.pos
                    size: self.size

            # Tags will be added here dynamically
            # Pre-filled example tags:
            BoxLayout:
                size_hint_y: None
                height: 30
                spacing: 5
                canvas.before:
                    Color:
                        rgba: 0.8, 0.8, 0.8, 1  # Gray tag box
                    Rectangle:
                        pos: self.pos
                        size: self.size
                Label:
                    text: "anime"
                    font_size: '14sp'
                    color: 0, 0, 0, 1
                    halign: 'left'
                    valign: 'center'
                    text_size: self.size
                Button:
                    text: "×"
                    size_hint_x: None
                    width: 25
                    background_normal: ''
                    background_color: 1, 0.4, 0.4, 1
                    color: 1, 1, 1, 1
                    font_size: '16sp'
                    on_press: root.remove_tag(self.parent)

            BoxLayout:
                size_hint_y: None
                height: 30
                spacing: 5
                canvas.before:
                    Color:
                        rgba: 0.8, 0.8, 0.8, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                Label:
                    text: "games"
                    font_size: '14sp'
                    color: 0, 0, 0, 1
                    halign: 'left'
                    valign: 'center'
                    text_size: self.size
                Button:
                    text: "×"
                    size_hint_x: None
                    width: 25
                    background_normal: ''
                    background_color: 1, 0.4, 0.4, 1
                    color: 1, 1, 1, 1
                    font_size: '16sp'
                    on_press: root.remove_tag(self.parent)

            # Add Tag Button (+)
            Button:
                size_hint_y: None
                height: 30
                text: "+"
                font_size: '20sp'
                background_normal: ''
                background_color: 0.85, 0.85, 0.85, 1
                color: 0, 0, 0, 1
                on_press: root.add_tag_prompt("likes")

        # --- DISLIKES ---
        Label:
            text: "DISLIKES:"
            font_size: '20sp'
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            size_hint_y: None
            height: 35

        BoxLayout:
            id: dislikes_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height if self.children else 40
            padding: [10, 10]
            spacing: 8
            canvas.before:
                Color:
                    rgba: 0.9, 0.9, 0.9, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            BoxLayout:
                size_hint_y: None
                height: 30
                spacing: 5
                canvas.before:
                    Color:
                        rgba: 0.8, 0.8, 0.8, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                Label:
                    text: "broccoli"
                    font_size: '14sp'
                    color: 0, 0, 0, 1
                    halign: 'left'
                    valign: 'center'
                    text_size: self.size
                Button:
                    text: "×"
                    size_hint_x: None
                    width: 25
                    background_normal: ''
                    background_color: 1, 0.4, 0.4, 1
                    color: 1, 1, 1, 1
                    font_size: '16sp'
                    on_press: root.remove_tag(self.parent)

            Button:
                size_hint_y: None
                height: 30
                text: "+"
                font_size: '20sp'
                background_normal: ''
                background_color: 0.85, 0.85, 0.85, 1
                color: 0, 0, 0, 1
                on_press: root.add_tag_prompt("dislikes")

        # --- GOALS ---
        Label:
            text: "GOALS:"
            font_size: '20sp'
            bold: True
            color: 0, 0, 0, 1
            halign: 'left'
            size_hint_y: None
            height: 35

        BoxLayout:
            id: goals_container
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height if self.children else 40
            padding: [10, 10]
            spacing: 8
            canvas.before:
                Color:
                    rgba: 0.9, 0.9, 0.9, 1
                Rectangle:
                    pos: self.pos
                    size: self.size

            BoxLayout:
                size_hint_y: None
                height: 30
                spacing: 5
                canvas.before:
                    Color:
                        rgba: 0.8, 0.8, 0.8, 1
                    Rectangle:
                        pos: self.pos
                        size: self.size
                Label:
                    text: "Eat more veggies"
                    font_size: '14sp'
                    color: 0, 0, 0, 1
                    halign: 'left'
                    valign: 'center'
                    text_size: self.size
                Button:
                    text: "×"
                    size_hint_x: None
                    width: 25
                    background_normal: ''
                    background_color: 1, 0.4, 0.4, 1
                    color: 1, 1, 1, 1
                    font_size: '16sp'
                    on_press: root.remove_tag(self.parent)

            Button:
                size_hint_y: None
                height: 30
                text: "+"
                font_size: '20sp'
                background_normal: ''
                background_color: 0.85, 0.85, 0.85, 1
                color: 0, 0, 0, 1
                on_press: root.add_tag_prompt("goals")
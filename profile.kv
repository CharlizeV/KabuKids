<ProfilePage>:
    name: "profile"
    BoxLayout:
        orientation: 'vertical'
        padding: [20, 20]
        spacing: 15

        # --- Top Bar: Profile Pic + Name/Birthday + Back Button ---
        BoxLayout:
            size_hint_y: None
            height: 70
            spacing: 15

            # Profile Picture Placeholder (gray square)
            Widget:
                size_hint_x: None
                width: 60
                canvas:
                    Color:
                        rgba: 0.8, 0.8, 0.8, 1  # Light gray
                    Rectangle:
                        pos: self.pos
                        size: self.size

            # Name and Birthday
            BoxLayout:
                orientation: 'vertical'
                Label:
                    text: "Alex Rivera"
                    font_size: '18sp'
                    bold: True
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size
                Label:
                    text: "Birthday: March 12, 2015"
                    font_size: '14sp'
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

            # Spacer to push back button to right
            Widget:

            # Back Button (Top Right)
            Button:
                size_hint_x: None
                width: 50
                background_normal: ''
                background_color: 0.7, 0.7, 0.7, 1
                text: "<"
                font_size: '24sp'
                color: 0, 0, 0, 1
                on_press: app.root.current = "dashboard"

        # --- Divider (80% width, centered) ---
        Widget:
            size_hint_y: None
            height: 2
            canvas:
                Color:
                    rgba: 0.7, 0.7, 0.7, 1
                Rectangle:
                    pos: (self.parent.x + self.parent.width * 0.1, self.y)  # 10% margin each side
                    size: (self.parent.width * 0.8, 2)

        # --- LIKES Section ---
        Label:
            text: "LIKES:"
            font_size: '20sp'
            bold: True
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: 35

        BoxLayout:
            id: likes_box
            size_hint_y: None
            height: self.minimum_height if self.children else 40
            padding: [10, 10]
            spacing: 10
            canvas.before:
                Color:
                    rgba: 0.95, 0.95, 0.95, 1
                Line:
                    rectangle: (self.x, self.y, self.width, self.height)
                    width: 1.5

            # Sample tags (you can populate dynamically in Python)
            BoxLayout:
                size_hint_y: None
                height: 30
                spacing: 5
                Label:
                    text: "anime"
                    font_size: '14sp'
                    halign: 'left'
                    valign: 'center'
                    text_size: self.size
                Button:
                    text: "×"
                    size_hint_x: None
                    width: 25
                    background_normal: ''
                    background_color: 1, 0.4, 0.4, 1
                    color: 1, 1, 1, 1
                    font_size: '16sp'
                    on_press: root.remove_tag(self.parent)

            BoxLayout:
                size_hint_y: None
                height: 30
                spacing: 5
                Label:
                    text: "games"
                    font_size: '14sp'
                    halign: 'left'
                    valign: 'center'
                    text_size: self.size
                Button:
                    text: "×"
                    size_hint_x: None
                    width: 25
                    background_normal: ''
                    background_color: 1, 0.4, 0.4, 1
                    color: 1, 1, 1, 1
                    font_size: '16sp'
                    on_press: root.remove_tag(self.parent)

            BoxLayout:
                size_hint_y: None
                height: 30
                spacing: 5
                Label:
                    text: "pop music"
                    font_size: '14sp'
                    halign: 'left'
                    valign: 'center'
                    text_size: self.size
                Button:
                    text: "×"
                    size_hint_x: None
                    width: 25
                    background_normal: ''
                    background_color: 1, 0.4, 0.4, 1
                    color: 1, 1, 1, 1
                    font_size: '16sp'
                    on_press: root.remove_tag(self.parent)

        # --- DISLIKES Section ---
        Label:
            text: "DISLIKES:"
            font_size: '20sp'
            bold: True
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: 35

        BoxLayout:
            id: dislikes_box
            size_hint_y: None
            height: self.minimum_height if self.children else 40
            padding: [10, 10]
            spacing: 10
            canvas.before:
                Color:
                    rgba: 0.95, 0.95, 0.95, 1
                Line:
                    rectangle: (self.x, self.y, self.width, self.height)
                    width: 1.5

            BoxLayout:
                size_hint_y: None
                height: 30
                spacing: 5
                Label:
                    text: "broccoli"
                    font_size: '14sp'
                    halign: 'left'
                    valign: 'center'
                    text_size: self.size
                Button:
                    text: "×"
                    size_hint_x: None
                    width: 25
                    background_normal: ''
                    background_color: 1, 0.4, 0.4, 1
                    color: 1, 1, 1, 1
                    font_size: '16sp'
                    on_press: root.remove_tag(self.parent)

            BoxLayout:
                size_hint_y: None
                height: 30
                spacing: 5
                Label:
                    text: "early mornings"
                    font_size: '14sp'
                    halign: 'left'
                    valign: 'center'
                    text_size: self.size
                Button:
                    text: "×"
                    size_hint_x: None
                    width: 25
                    background_normal: ''
                    background_color: 1, 0.4, 0.4, 1
                    color: 1, 1, 1, 1
                    font_size: '16sp'
                    on_press: root.remove_tag(self.parent)

        # --- GOALS Section ---
        Label:
            text: "GOALS:"
            font_size: '20sp'
            bold: True
            halign: 'left'
            valign: 'top'
            text_size: self.size
            size_hint_y: None
            height: 35

        BoxLayout:
            id: goals_box
            size_hint_y: None
            height: self.minimum_height if self.children else 40
            padding: [10, 10]
            spacing: 10
            canvas.before:
                Color:
                    rgba: 0.95, 0.95, 0.95, 1
                Line:
                    rectangle: (self.x, self.y, self.width, self.height)
                    width: 1.5

            BoxLayout:
                size_hint_y: None
                height: 30
                spacing: 5
                Label:
                    text: "Eat more veggies"
                    font_size: '14sp'
                    halign: 'left'
                    valign: 'center'
                    text_size: self.size
                Button:
                    text: "×"
                    size_hint_x: None
                    width: 25
                    background_normal: ''
                    background_color: 1, 0.4, 0.4, 1
                    color: 1, 1, 1, 1
                    font_size: '16sp'
                    on_press: root.remove_tag(self.parent)

            BoxLayout:
                size_hint_y: None
                height: 30
                spacing: 5
                Label:
                    text: "Try new foods"
                    font_size: '14sp'
                    halign: 'left'
                    valign: 'center'
                    text_size: self.size
                Button:
                    text: "×"
                    size_hint_x: None
                    width: 25
                    background_normal: ''
                    background_color: 1, 0.4, 0.4, 1
                    color: 1, 1, 1, 1
                    font_size: '16sp'
                    on_press: root.remove_tag(self.parent)